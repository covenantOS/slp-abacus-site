---
/**
 * Final CTA Section - Dark theme only
 * Used as the closing call-to-action before the footer
 */
interface Props {
  headline: string;
  subheadline?: string;
  buttonText: string;
  buttonHref: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const { 
  headline, 
  subheadline, 
  buttonText, 
  buttonHref, 
  secondaryText, 
  secondaryHref
} = Astro.props;
---

<section class="bg-brand-dark py-20 relative overflow-hidden">
  <!-- Subtle background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>
  
  <div class="container relative z-10">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white mb-6 leading-tight">
        {headline}
      </h2>
      
      {subheadline && (
        <p class="text-lg md:text-xl text-white/70 mb-10 leading-relaxed max-w-2xl mx-auto">
          {subheadline}
        </p>
      )}
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href={buttonHref} 
          class="btn-primary text-lg px-8 py-4 inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          {buttonText}
        </a>
        
        {secondaryText && secondaryHref && (
          <a 
            href={secondaryHref} 
            class="text-white/70 hover:text-white font-semibold text-lg transition-colors inline-flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            {secondaryText}
          </a>
        )}
      </div>
      
      <p class="text-white/40 text-sm mt-8">
        No contracts. No pressure. Just a clear growth plan.
      </p>
    </div>
  </div>
</section>
