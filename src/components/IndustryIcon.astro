---
/**
 * Professional SVG icons for industries
 * Replaces emoji icons with clean, brand-consistent SVGs
 */
interface Props {
  industry: string;
  class?: string;
}

const { industry, class: className = '' } = Astro.props;
---

{industry === 'hvac' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 9a4 4 0 0 0-2 7.5"/>
    <path d="M12 3v2"/>
    <path d="m6.6 18.4-1.4 1.4"/>
    <path d="M20 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"/>
    <path d="M4 13H2"/>
    <path d="M6.34 7.34 4.93 5.93"/>
  </svg>
)}

{industry === 'plumbing' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14.5 3h-5L7 7.5v5L10 16h4l3-3.5v-5L14.5 3z"/>
    <path d="M12 16v5"/>
    <path d="M9 21h6"/>
    <path d="M10 7h4"/>
    <path d="M10 10h4"/>
  </svg>
)}

{industry === 'roofing' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
    <polyline points="9 22 9 12 15 12 15 22"/>
  </svg>
)}

{industry === 'electrical' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
  </svg>
)}

{industry === 'pest-control' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
    <path d="m9 12 2 2 4-4"/>
  </svg>
)}

{industry === 'garage-doors' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="18" height="18" rx="2"/>
    <path d="M3 9h18"/>
    <path d="M3 15h18"/>
    <path d="M9 21V9"/>
  </svg>
)}

{industry === 'landscaping' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 10a6 6 0 0 0 6-6c0 6-6 6-6 12"/>
    <path d="M12 10a6 6 0 0 1-6-6c0 6 6 6 6 12"/>
    <path d="M12 22v-10"/>
    <path d="M4 22h16"/>
  </svg>
)}

{industry === 'pool-services' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M2 12h20"/>
    <path d="M2 16c2 2 4 2 6 0s4-2 6 0 4 2 6 0"/>
    <path d="M2 8c2 2 4 2 6 0s4-2 6 0 4 2 6 0"/>
    <circle cx="12" cy="12" r="1"/>
  </svg>
)}

{industry === 'windows-doors' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="18" height="18" rx="2"/>
    <path d="M12 3v18"/>
    <path d="M3 12h18"/>
  </svg>
)}

{industry === 'painting' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2z"/>
    <path d="M12 11V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
    <path d="M18 6h-2"/>
    <path d="M12 15h.01"/>
  </svg>
)}
