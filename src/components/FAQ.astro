---
interface FAQItem {
  question: string;
  answer: string;
}
interface Props {
  items: FAQItem[];
  headline?: string;
}
const { items, headline = 'Frequently Asked Questions' } = Astro.props;
---

<div class="container max-w-3xl">
  <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-brand-dark">{headline}</h2>
  <div class="space-y-4" id="faq-accordion">
    {items.map((item) => (
      <details class="bg-white rounded-xl border border-brand-soft-gray shadow-sm group" name="faq">
        <summary class="flex items-center justify-between p-6 cursor-pointer list-none font-semibold text-lg text-brand-dark hover:text-brand-red transition-colors">
          <span class="pr-4">{item.question}</span>
          <svg class="w-5 h-5 text-brand-red shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-6 pb-6 text-brand-medium-gray leading-relaxed text-container">
          <Fragment set:html={item.answer} />
        </div>
      </details>
    ))}
  </div>
</div>
