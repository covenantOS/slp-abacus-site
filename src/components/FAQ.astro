---
interface FAQItem {
  question: string;
  answer: string;
}
interface Props {
  items: FAQItem[];
  headline?: string;
}
const { items, headline = 'Frequently Asked Questions' } = Astro.props;
---

<section class="section-light py-20">
  <div class="container max-w-3xl">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">{headline}</h2>
    <div class="space-y-4" id="faq-accordion">
      {items.map((item, i) => (
        <details class="bg-white rounded-xl border border-gray-100 shadow-sm group" name="faq">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none font-semibold text-lg text-brand-dark hover:text-brand-red transition-colors">
            {item.question}
            <svg class="w-5 h-5 text-brand-red shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-6 text-brand-near-black/70 leading-relaxed">
            <Fragment set:html={item.answer} />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
