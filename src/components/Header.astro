---
// Mega Menu Navigation Component
const services = [
  {
    title: 'Local SEO',
    description: 'Dominate Google Maps with our 90-day guarantee',
    href: '/services/local-seo/',
    icon: '📍',
    image: '/assets/images/services/seo-dashboard.png'
  },
  {
    title: 'Google Ads & PPC',
    description: 'Get leads from day one with no management fees',
    href: '/services/ppc/',
    icon: '📈',
    image: '/assets/images/services/seo-dashboard.png'
  },
  {
    title: 'Web Design',
    description: 'Custom Astro or WordPress sites built to convert',
    href: '/services/web-design/',
    icon: '💻',
    image: '/assets/images/team/marketing-team-meeting.jpg'
  },
  {
    title: 'TV & Streaming',
    description: 'Exclusive Spectrum partnership with free videography',
    href: '/services/tv-streaming/',
    icon: '📺',
    image: '/assets/images/hero/team-collaboration.jpg'
  }
];

const industries = [
  { name: 'HVAC', href: '/industries/hvac/', icon: '🌡️' },
  { name: 'Plumbing', href: '/industries/plumbing/', icon: '🔧' },
  { name: 'Roofing', href: '/industries/roofing/', icon: '🏠' },
  { name: 'Electrical', href: '/industries/electrical/', icon: '⚡' },
  { name: 'Pest Control', href: '/industries/pest-control/', icon: '🛡️' },
  { name: 'Garage Doors', href: '/industries/garage-doors/', icon: '🚪' },
  { name: 'Landscaping', href: '/industries/landscaping/', icon: '🌿' },
  { name: 'Pool Services', href: '/industries/pool-services/', icon: '🏊' },
];

const featuredCaseStudy = {
  title: 'Tampa HVAC Company',
  metric: '#1 in Map Pack in 47 Days',
  industry: 'HVAC',
  href: '/case-studies/tampa-hvac/',
  image: '/assets/images/services/seo-dashboard.png'
};
---

<header class="section-dark sticky top-0 z-50 border-b border-white/10">
  <div class="container">
    <!-- Top utility bar -->
    <div class="hidden lg:flex items-center justify-end gap-6 py-2 text-xs border-b border-white/5">
      <a href="tel:+18135213199" class="text-brand-medium-gray hover:text-white flex items-center gap-1.5 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        (813) 521-3199
      </a>
      <span class="text-brand-medium-gray/50">|</span>
      <span class="text-brand-gold font-semibold flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        90-Day Top 3 Guarantee
      </span>
      <span class="text-brand-medium-gray/50">|</span>
      <span class="text-brand-medium-gray">Tampa, FL • National Service</span>
    </div>

    <!-- Main navigation bar -->
    <div class="flex items-center justify-between py-4">
      <!-- Logo -->
      <a href="/" class="flex items-center shrink-0">
        <img
          src="/assets/logos/serviceline-logo-header.webp"
          alt="ServiceLinePro"
          width="180"
          height="55"
          class="h-10 w-auto"
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        <!-- Services Dropdown -->
        <div class="relative group">
          <button class="nav-link flex items-center gap-1 px-4 py-3 text-sm font-medium text-white/80 hover:text-white transition-colors font-[family-name:var(--font-ui)]">
            Services
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          
          <!-- Mega Menu Panel -->
          <div class="mega-menu absolute top-full left-0 w-[900px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 pt-2 z-50">
            <div class="bg-brand-dark/98 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/10 p-6 grid grid-cols-3 gap-6">
              <!-- Services Grid -->
              <div class="col-span-2">
                <p class="text-brand-gold text-xs font-semibold uppercase tracking-wider mb-4">Our Services</p>
                <div class="grid grid-cols-2 gap-3">
                  {services.map((service) => (
                    <a href={service.href} class="group/item flex gap-3 p-3 rounded-xl hover:bg-white/5 transition-all">
                      <div class="w-14 h-14 rounded-lg overflow-hidden shrink-0 bg-brand-red/10">
                        <img src={service.image} alt={service.title} class="w-full h-full object-cover opacity-80 group-hover/item:opacity-100 transition-opacity" />
                      </div>
                      <div>
                        <p class="font-semibold text-white group-hover/item:text-brand-gold transition-colors flex items-center gap-2">
                          <span class="text-lg">{service.icon}</span>
                          {service.title}
                        </p>
                        <p class="text-xs text-brand-medium-gray mt-0.5 line-clamp-2">{service.description}</p>
                      </div>
                    </a>
                  ))}
                </div>
                <div class="mt-4 pt-4 border-t border-white/10">
                  <a href="/services/" class="text-brand-red text-sm font-semibold hover:text-brand-coral flex items-center gap-1">
                    View All Services <span>&rarr;</span>
                  </a>
                </div>
              </div>
              
              <!-- Featured Case Study -->
              <div class="border-l border-white/10 pl-6">
                <p class="text-brand-gold text-xs font-semibold uppercase tracking-wider mb-4">Featured Result</p>
                <a href={featuredCaseStudy.href} class="block group/case">
                  <div class="relative rounded-xl overflow-hidden mb-3 aspect-video">
                    <img src={featuredCaseStudy.image} alt={featuredCaseStudy.title} class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                    <div class="absolute bottom-2 left-2">
                      <span class="bg-brand-red text-white text-xs font-bold px-2 py-0.5 rounded">{featuredCaseStudy.industry}</span>
                    </div>
                  </div>
                  <p class="font-bold text-white text-lg group-hover/case:text-brand-gold transition-colors">{featuredCaseStudy.metric}</p>
                  <p class="text-brand-medium-gray text-sm">{featuredCaseStudy.title}</p>
                </a>
                <a href="/case-studies/" class="text-brand-red text-sm font-semibold hover:text-brand-coral flex items-center gap-1 mt-4">
                  All Case Studies <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Industries Dropdown -->
        <div class="relative group">
          <button class="nav-link flex items-center gap-1 px-4 py-3 text-sm font-medium text-white/80 hover:text-white transition-colors font-[family-name:var(--font-ui)]">
            Industries
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          
          <!-- Industries Dropdown -->
          <div class="mega-menu absolute top-full left-1/2 -translate-x-1/2 w-[500px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 pt-2">
            <div class="bg-brand-dark/98 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/10 p-6">
              <p class="text-brand-gold text-xs font-semibold uppercase tracking-wider mb-4">Industries We Serve</p>
              <div class="grid grid-cols-2 gap-2">
                {industries.map((industry) => (
                  <a href={industry.href} class="flex items-center gap-3 p-3 rounded-lg hover:bg-white/5 transition-all group/ind">
                    <span class="text-xl">{industry.icon}</span>
                    <span class="font-medium text-white group-hover/ind:text-brand-gold transition-colors">{industry.name}</span>
                  </a>
                ))}
              </div>
              <div class="mt-4 pt-4 border-t border-white/10">
                <a href="/industries/" class="text-brand-red text-sm font-semibold hover:text-brand-coral flex items-center gap-1">
                  View All Industries <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Simple Nav Links -->
        <a href="/case-studies/" class="px-4 py-3 text-sm font-medium text-white/80 hover:text-white transition-colors font-[family-name:var(--font-ui)]">
          Case Studies
        </a>
        <a href="/about/" class="px-4 py-3 text-sm font-medium text-white/80 hover:text-white transition-colors font-[family-name:var(--font-ui)]">
          About
        </a>
        <a href="/blog/" class="px-4 py-3 text-sm font-medium text-white/80 hover:text-white transition-colors font-[family-name:var(--font-ui)]">
          Blog
        </a>
        <a href="/contact/" class="px-4 py-3 text-sm font-medium text-white/80 hover:text-white transition-colors font-[family-name:var(--font-ui)]">
          Contact
        </a>
      </nav>

      <!-- CTA Button -->
      <div class="hidden lg:flex items-center gap-4">
        <a href="/booking/" class="btn-primary text-sm !py-2.5 !px-5 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Book Strategy Call
        </a>
      </div>

      <!-- Mobile Menu Toggle -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden text-white p-2 rounded-lg hover:bg-white/10 transition-colors"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 bg-brand-dark/98 backdrop-blur-xl">
    <nav class="container py-4" aria-label="Mobile navigation">
      <!-- Mobile Services Accordion -->
      <div class="mobile-accordion border-b border-white/10">
        <button class="w-full flex items-center justify-between py-4 text-white font-medium" data-accordion="services">
          Services
          <svg class="w-5 h-5 transition-transform accordion-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="accordion-content hidden pb-4 space-y-2" id="services-content">
          {services.map((service) => (
            <a href={service.href} class="flex items-center gap-3 p-3 rounded-lg bg-white/5">
              <span class="text-lg">{service.icon}</span>
              <div>
                <p class="font-medium text-white">{service.title}</p>
                <p class="text-xs text-brand-medium-gray">{service.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Mobile Industries Accordion -->
      <div class="mobile-accordion border-b border-white/10">
        <button class="w-full flex items-center justify-between py-4 text-white font-medium" data-accordion="industries">
          Industries
          <svg class="w-5 h-5 transition-transform accordion-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="accordion-content hidden pb-4 grid grid-cols-2 gap-2" id="industries-content">
          {industries.map((industry) => (
            <a href={industry.href} class="flex items-center gap-2 p-2 rounded-lg bg-white/5">
              <span>{industry.icon}</span>
              <span class="text-sm text-white">{industry.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Mobile Simple Links -->
      <a href="/case-studies/" class="block py-4 text-white font-medium border-b border-white/10">Case Studies</a>
      <a href="/about/" class="block py-4 text-white font-medium border-b border-white/10">About</a>
      <a href="/blog/" class="block py-4 text-white font-medium border-b border-white/10">Blog</a>
      <a href="/contact/" class="block py-4 text-white font-medium border-b border-white/10">Contact</a>
      
      <!-- Mobile CTA -->
      <div class="pt-4 space-y-3">
        <a href="/booking/" class="btn-primary w-full text-center flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Book Strategy Call
        </a>
        <a href="tel:+18135213199" class="btn-secondary w-full text-center flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          (813) 521-3199
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .mega-menu {
    transform-origin: top left;
  }
  
  .group:hover .mega-menu {
    animation: fadeIn 0.2s ease-out forwards;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .mobile-accordion .accordion-icon.rotate {
    transform: rotate(180deg);
  }
</style>

<script is:inline>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  
  btn?.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    menu.classList.toggle('hidden');
    menuIcon.classList.toggle('hidden');
    closeIcon.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Mobile accordion toggles
  document.querySelectorAll('[data-accordion]').forEach(button => {
    button.addEventListener('click', () => {
      const target = button.getAttribute('data-accordion');
      const content = document.getElementById(`${target}-content`);
      const icon = button.querySelector('.accordion-icon');
      
      content.classList.toggle('hidden');
      icon.classList.toggle('rotate');
    });
  });
</script>
