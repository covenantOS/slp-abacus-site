---
interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;

const signals = [
  {
    value: '90-Day',
    label: 'Top 3 Guarantee',
    iconPath: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z'
  },
  {
    value: '500+',
    label: 'Keywords Ranked',
    iconPath: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6'
  },
  {
    value: '8+',
    label: 'Industries Served',
    iconPath: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4'
  },
  {
    value: 'Spectrum',
    label: 'Certified Partner',
    iconPath: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z'
  }
];
---

<section class={`py-6 ${dark ? 'bg-brand-dark border-y border-white/10' : 'bg-white border-y border-brand-soft-gray'}`}>
  <div class="container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      {signals.map((signal) => (
        <div class="flex items-center gap-3">
          <div class={`p-2 rounded-lg ${dark ? 'bg-white/10' : 'bg-brand-soft-red'}`}>
            <svg class={`w-5 h-5 ${dark ? 'text-white' : 'text-brand-red'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={signal.iconPath} />
            </svg>
          </div>
          <div>
            <p class={`text-lg font-bold ${dark ? 'text-white' : 'text-brand-dark'}`}>{signal.value}</p>
            <p class={`text-xs ${dark ? 'text-white/60' : 'text-brand-medium-gray'}`}>{signal.label}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
