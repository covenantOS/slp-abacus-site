---
interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;

const signals = [
  {
    icon: '🛡️',
    value: '90-Day',
    label: 'Top 3 Guarantee'
  },
  {
    icon: '📈',
    value: '500+',
    label: 'Keywords Ranked'
  },
  {
    icon: '🏢',
    value: '8+',
    label: 'Industries Served'
  },
  {
    icon: '🤝',
    value: 'Spectrum',
    label: 'Certified Partner'
  }
];
---

<section class={`py-6 ${dark ? 'bg-brand-dark/80 border-y border-white/10' : 'bg-white border-y border-gray-100'}`}>
  <div class="container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      {signals.map((signal) => (
        <div class="flex items-center gap-3">
          <span class="text-2xl">{signal.icon}</span>
          <div>
            <p class={`text-lg font-bold ${dark ? 'text-white' : 'text-brand-dark'}`}>{signal.value}</p>
            <p class={`text-xs ${dark ? 'text-brand-medium-gray' : 'text-brand-near-black/60'}`}>{signal.label}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
