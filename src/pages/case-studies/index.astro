---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="Case Studies" description="See how ServiceLinePro helps home services businesses grow with measurable results.">
  <section class="section-dark py-20">
    <div class="container">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Case Studies</h1>
      <p class="text-brand-medium-gray text-lg max-w-2xl">
        Real results from real home services businesses.
      </p>
    </div>
  </section>
  <section class="py-16">
    <div class="container">
      <p class="text-lg text-brand-near-black">Case studies coming soon.</p>
    </div>
  </section>
</PageLayout>
