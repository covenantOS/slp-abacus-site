---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="Blog" description="Marketing insights, SEO tips, and industry news for home services businesses.">
  <section class="section-dark py-20">
    <div class="container">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Blog</h1>
      <p class="text-brand-medium-gray text-lg max-w-2xl">
        Marketing insights, SEO tips, and industry news.
      </p>
    </div>
  </section>
  <section class="py-16">
    <div class="container">
      <p class="text-lg text-brand-near-black">Blog posts coming soon.</p>
    </div>
  </section>
</PageLayout>
