---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Book a Strategy Call" description="Schedule a free strategy call with ServiceLinePro to discuss growing your home services business.">
  <section class="section-dark py-20">
    <div class="container">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Book a Strategy Call</h1>
      <p class="text-brand-medium-gray text-lg max-w-2xl">
        Let's discuss how we can help your business grow.
      </p>
    </div>
  </section>
  <section class="py-16">
    <div class="container">
      <p class="text-lg text-brand-near-black">Booking form coming soon.</p>
    </div>
  </section>
</PageLayout>
