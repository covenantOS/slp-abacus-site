---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/CTASection.astro';
import FAQ from '../components/FAQ.astro';
import IndustryIcon from '../components/IndustryIcon.astro';

const homeFaqs = [
  {
    question: 'What types of home services businesses do you work with?',
    answer: 'We specialize in HVAC, plumbing, roofing, electrical, pest control, garage door, landscaping, and other home services businesses generating $1M+ in annual revenue. Our strategies are built for companies ready to scale — not startups.',
  },
  {
    question: 'What makes ServiceLinePro different from other marketing agencies?',
    answer: 'Three things: First, we exclusively serve home services businesses — we know your customer, your market, and your competition. Second, our <strong>Spectrum partnership</strong> gives clients access to TV and streaming advertising with free professional videography for Florida-based businesses. Third, our <strong>90-day Top 3 Map Pack guarantee</strong> means we put our money where our mouth is.',
  },
  {
    question: 'Do you require long-term contracts?',
    answer: 'No. We offer month-to-month agreements on most services. We do offer a 12-month commitment option that waives setup fees entirely — saving you $1,500–$2,500 upfront — but it\'s your choice. We earn your business every month.',
  },
  {
    question: 'How quickly will I see results?',
    answer: 'It depends on the service. With our <a href="/services/local-seo/">Local SEO Accelerator</a>, many clients see visible movement in their Google Map Pack rankings within 7–10 days. <a href="/services/ppc/">PPC campaigns</a> generate leads from day one. <a href="/services/web-design/">Website projects</a> typically launch within 4–6 weeks.',
  },
  {
    question: 'Do you serve businesses outside of Florida?',
    answer: 'Absolutely. Our headquarters are in Tampa, FL, but we serve home services businesses nationwide. Our Local SEO, PPC, and web design services work in any market. TV/streaming advertising through our Spectrum partnership is available in Spectrum service areas across the country.',
  },
];

const stats = [
  { value: "500+", label: "Keywords Ranked" },
  { value: "47", label: "Avg. Days to Top 3" },
  { value: "$12M+", label: "Revenue Generated" },
  { value: "98%", label: "Client Retention" }
];

const services = [
  {
    title: "Local SEO & Map Pack",
    description: "Lead your local market with our proven Foundation + Accelerator system. We guarantee top 3 Map Pack rankings in 90 days or we work for free.",
    price: "Starting at $1,500/mo",
    href: "/services/local-seo/",
    features: ["90-Day Guarantee", "GBP Optimization", "Citation Building", "Review Management"],
    icon: "search"
  },
  {
    title: "Google Ads & PPC",
    description: "Get leads from day one with expertly managed campaigns. Through our Spectrum partnership, qualified clients pay zero management fees.",
    price: "Custom pricing",
    href: "/services/ppc/",
    features: ["$0 Management Fees*", "Google & Bing Ads", "Landing Page Design", "Call Tracking"],
    icon: "cursor"
  },
  {
    title: "Custom Web Design",
    description: "Lightning-fast Astro or WordPress websites custom-built to convert visitors into booked jobs. No templates. No page builders.",
    price: "Starting at $250/mo",
    href: "/services/web-design/",
    features: ["Mobile-First Design", "SEO Optimized", "Conversion Focused", "CMS Included"],
    icon: "code"
  },
  {
    title: "TV & Streaming Ads",
    description: "Our exclusive Spectrum partnership puts your business on TV and streaming platforms. Florida clients receive complimentary professional videography.",
    price: "Custom pricing",
    href: "/services/tv-streaming/",
    features: ["Free Videography (FL)", "Geo-Targeted Ads", "Cross-Channel", "Brand Building"],
    icon: "tv",
    highlight: true
  }
];

const industries = [
  { name: 'HVAC', slug: 'hvac', href: '/industries/hvac/' },
  { name: 'Plumbing', slug: 'plumbing', href: '/industries/plumbing/' },
  { name: 'Roofing', slug: 'roofing', href: '/industries/roofing/' },
  { name: 'Electrical', slug: 'electrical', href: '/industries/electrical/' },
  { name: 'Pest Control', slug: 'pest-control', href: '/industries/pest-control/' },
  { name: 'Garage Doors', slug: 'garage-doors', href: '/industries/garage-doors/' },
  { name: 'Landscaping', slug: 'landscaping', href: '/industries/landscaping/' },
  { name: 'Pool Services', slug: 'pool-services', href: '/industries/pool-services/' },
];

const testimonials = [
  {
    name: "Mike Johnson",
    company: "Johnson's HVAC Solutions",
    industry: "HVAC",
    location: "Tampa, FL",
    image: "/assets/images/testimonials/client-mike-johnson.jpg",
    quote: "We went from page 3 to #1 in the Map Pack in just 47 days. Our phone hasn't stopped ringing. ServiceLinePro understands HVAC marketing like no other agency I've worked with.",
    result: "#1 Map Pack in 47 Days",
    metric: "+340% Leads"
  },
  {
    name: "Robert Chen",
    company: "Premier Plumbing Pro",
    industry: "Plumbing",
    location: "Orlando, FL",
    image: "/assets/images/testimonials/client-robert-chen.jpg",
    quote: "The combination of SEO and their Spectrum TV partnership has transformed our business. We're now the most recognized plumbing company in our area.",
    result: "285% Traffic Increase",
    metric: "$1.8M Revenue"
  },
  {
    name: "David Martinez",
    company: "Clearwater Elite Roofing",
    industry: "Roofing",
    location: "Clearwater, FL",
    image: "/assets/images/testimonials/client-david-martinez.jpg",
    quote: "I was skeptical about the 90-day guarantee, but they delivered. Now we're dominating 3 cities with their multi-location strategy. Best marketing investment we've made.",
    result: "#1 in 3 Cities",
    metric: "+$1.2M New Revenue"
  }
];

const caseStudies = [
  {
    title: "Tampa HVAC Company",
    metric: "#1 in Map Pack",
    timeframe: "47 Days",
    industry: "HVAC",
    services: ["Local SEO", "Web Design"]
  },
  {
    title: "Orlando Plumbing Pro",
    metric: "+285% Organic Traffic",
    timeframe: "90 Days",
    industry: "Plumbing",
    services: ["Local SEO", "PPC"]
  },
  {
    title: "Clearwater Roofing",
    metric: "$1.2M New Revenue",
    timeframe: "6 Months",
    industry: "Roofing",
    services: ["TV Ads", "Local SEO"]
  }
];

const guaranteeTerms = [
  "Primary keyword must be achievable (we'll assess during strategy call)",
  "Client maintains 4+ star Google rating during campaign",
  "Client responds to review requests within 48 hours",
  "No other SEO providers working on the same properties",
  "Google Business Profile access provided within 3 business days"
];
---

<PageLayout
  title="Digital Marketing for Home Services | Local SEO, PPC, Web Design"
  description="ServiceLinePro — Digital marketing agency for home services businesses doing $1M+. Local SEO with 90-day Top 3 guarantee, Google Ads, custom websites, and TV/streaming ads via our Spectrum partnership. Tampa HQ, national reach."
  canonicalUrl="https://servicelinepro.com/"
>

  <!-- JSON-LD Schema -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness", "ProfessionalService"],
      "name": "ServiceLinePro",
      "url": "https://servicelinepro.com",
      "logo": "https://i.ytimg.com/vi/WdE4QLMESxQ/maxresdefault.jpg",
      "description": "Digital marketing agency specializing in Local SEO, PPC, Web Design, and TV/Streaming advertising for home services businesses doing $1M+ annually.",
      "telephone": "+1-813-521-3199",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tampa",
        "addressRegion": "FL",
        "addressCountry": "US"
      },
      "founder": {
        "@type": "Person",
        "name": "Will Hamilton",
        "jobTitle": "CEO & Founder"
      },
      "areaServed": { "@type": "Country", "name": "United States" },
      "sameAs": [
        "https://www.facebook.com/servicelinepro",
        "https://www.instagram.com/servicelinepro",
        "https://www.linkedin.com/company/servicelinepro"
      ]
    })} />
  </Fragment>

  <!-- ============================================
       HERO SECTION - With Hero Image & Simplified Form
       ============================================ -->
  <section class="bg-brand-off-white min-h-[90vh] flex items-center relative overflow-hidden">
    <!-- Hero background image overlay -->
    <div class="absolute inset-0 lg:w-1/2 lg:left-1/2">
      <img 
        src="/assets/images/hero/hvac-technician-hero.jpg" 
        alt="HVAC technician servicing air conditioning unit at customer's home"
        class="w-full h-full object-cover opacity-20 lg:opacity-100"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-off-white via-brand-off-white/90 to-transparent lg:from-brand-off-white lg:via-brand-off-white/70 lg:to-transparent"></div>
    </div>
    
    <div class="container relative z-10 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Hero Content -->
        <div class="text-container-wide">
          <!-- Partnership Badge -->
          <div class="inline-flex items-center gap-2 bg-white border border-brand-soft-gray rounded-full px-4 py-2 mb-8 shadow-sm">
            <span class="text-brand-red font-semibold text-sm">Spectrum Reach Partner</span>
            <span class="text-brand-medium-gray">•</span>
            <span class="text-brand-medium-gray text-sm">Tampa, FL</span>
          </div>
          
          <h1 class="text-brand-dark leading-tight mb-6">
            Grow Your Local Market.<br />
            <span class="text-brand-red">Build Revenue.</span> <span class="text-brand-gold">Create Legacy.</span>
          </h1>
          
          <p class="text-lg md:text-xl text-brand-medium-gray leading-relaxed mb-8">
            The digital marketing agency built <strong class="text-brand-dark">exclusively for home services businesses</strong> doing $1M+ annually. Local SEO with a 90-day guarantee, Google Ads, custom websites, and TV advertising through our Spectrum partnership.
          </p>
          
          <!-- Single Primary CTA -->
          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="/booking/" class="btn-primary text-lg px-8 py-4">
              Get Your Free Growth Plan →
            </a>
            <a href="tel:+18135213199" class="btn-secondary text-lg px-8 py-4">
              📞 (813) 521-3199
            </a>
          </div>
          
          <!-- Trust Indicators -->
          <div class="flex flex-wrap items-center gap-4 text-sm text-brand-medium-gray">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              90-Day Guarantee
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              No Contracts
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Tampa-Based
            </span>
          </div>
        </div>
        
        <!-- Simplified Hero Form Card (3 Fields) -->
        <div class="hidden lg:block">
          <div class="bg-white rounded-2xl shadow-xl border border-brand-soft-gray p-8 max-w-md ml-auto">
            <div class="text-center mb-6">
              <h2 class="text-2xl font-bold text-brand-dark mb-2">Get Your Free Growth Plan</h2>
              <p class="text-brand-medium-gray text-sm">See how we can help you lead your market in 90 days</p>
            </div>
            
            <form id="hero-form" class="space-y-4">
              <input type="text" name="name" placeholder="Your Name" required class="form-input" />
              <input type="email" name="email" placeholder="Email Address" required class="form-input" />
              <input type="tel" name="phone" placeholder="Phone Number" required class="form-input" />
              <button type="submit" class="btn-primary w-full text-lg py-4">
                Get My Free Strategy Call →
              </button>
            </form>
            
            <p class="text-center text-xs text-brand-medium-gray mt-4">
              No contracts. No pressure. Just a clear growth plan.
            </p>
            
            <!-- Mini trust signal -->
            <div class="flex items-center justify-center gap-4 mt-6 pt-4 border-t border-brand-soft-gray">
              <div class="text-center">
                <p class="text-lg font-bold text-brand-dark">4.9★</p>
                <p class="text-xs text-brand-medium-gray">Client Rating</p>
              </div>
              <div class="h-8 w-px bg-brand-soft-gray"></div>
              <div class="text-center">
                <p class="text-lg font-bold text-brand-dark">100+</p>
                <p class="text-xs text-brand-medium-gray">Clients</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       STATS BAR
       ============================================ -->
  <section class="bg-white py-10 border-y border-brand-soft-gray">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map((stat) => (
          <div class="text-center">
            <p class="text-3xl md:text-4xl font-extrabold text-brand-red mb-1">{stat.value}</p>
            <p class="text-brand-medium-gray text-sm font-medium">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       INDUSTRY CREDIBILITY BAR - ServiceTitan, Housecall Pro
       ============================================ -->
  <section class="bg-brand-off-white py-8">
    <div class="container">
      <p class="text-center text-sm text-brand-medium-gray mb-6">We integrate with the tools you already use</p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-brand-soft-red rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-brand-red" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <div>
            <p class="text-xs text-brand-medium-gray uppercase tracking-wider">Certified Partner</p>
            <p class="font-bold text-brand-dark">Spectrum Reach</p>
          </div>
        </div>
        <div class="h-8 w-px bg-brand-soft-gray hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg class="h-8 w-8 text-brand-dark" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
          </svg>
          <span class="font-semibold text-brand-dark">Google Partner</span>
        </div>
        <div class="h-8 w-px bg-brand-soft-gray hidden md:block"></div>
        <div class="text-center px-4 py-2 bg-white rounded-lg border border-brand-soft-gray">
          <p class="font-semibold text-brand-dark text-sm">ServiceTitan</p>
          <p class="text-xs text-brand-medium-gray">Compatible</p>
        </div>
        <div class="text-center px-4 py-2 bg-white rounded-lg border border-brand-soft-gray">
          <p class="font-semibold text-brand-dark text-sm">Housecall Pro</p>
          <p class="text-xs text-brand-medium-gray">Compatible</p>
        </div>
        <div class="text-center px-4 py-2 bg-white rounded-lg border border-brand-soft-gray">
          <p class="font-semibold text-brand-dark text-sm">Jobber</p>
          <p class="text-xs text-brand-medium-gray">Compatible</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       MEET THE FOUNDER - Will Hamilton
       ============================================ -->
  <section class="bg-white py-20">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <p class="section-label">Meet the Founder</p>
          <h2 class="mb-6">Hi, I'm Will Hamilton.</h2>
          <div class="text-container">
            <p class="text-lg text-brand-medium-gray leading-relaxed mb-6">
              I started ServiceLinePro in 2020 because I was tired of watching home service business owners get ripped off by marketing agencies that didn't understand their industry.
            </p>
            <p class="text-brand-medium-gray leading-relaxed mb-6">
              Before ServiceLinePro, I spent years working with trades businesses and saw the same pattern: generic agencies promising the world, taking monthly retainers, and delivering nothing but confusion and excuses.
            </p>
            <p class="text-brand-medium-gray leading-relaxed mb-6">
              <strong class="text-brand-dark">That's why we built something different.</strong> We only work with home services businesses. We guarantee results. And if we don't deliver, we work for free until we do.
            </p>
            <p class="text-brand-medium-gray leading-relaxed mb-8">
              Our team is based in Tampa, Florida, but we serve contractors nationwide. We speak your language — we understand seasonality, emergency calls, service areas, and why your Google reviews matter more than vanity metrics.
            </p>
            <div class="flex items-center gap-4">
              <a href="/about/" class="btn-secondary">Meet Our Team →</a>
              <a href="https://www.linkedin.com/in/willhamilton" target="_blank" rel="noopener" class="text-brand-medium-gray hover:text-brand-red transition-colors">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <div class="relative">
            <img 
              src="/assets/images/william-hamilton.webp" 
              alt="Will Hamilton, CEO and Founder of ServiceLinePro"
              class="rounded-2xl shadow-lg w-full max-w-md mx-auto"
            />
            <div class="absolute -bottom-4 -right-4 bg-brand-red text-white px-6 py-3 rounded-xl shadow-lg">
              <p class="font-bold">Will Hamilton</p>
              <p class="text-sm text-white/80">CEO & Founder</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       TESTIMONIALS - Real Clients, Real Results
       ============================================ -->
  <section class="bg-brand-light-gray py-20">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <p class="section-label">Client Success Stories</p>
        <h2>Real Clients. Real Results.</h2>
        <p class="text-brand-medium-gray text-lg mx-auto">
          Don't just take our word for it. Here's what business owners like you say about working with ServiceLinePro.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {testimonials.map((testimonial) => (
          <div class="bg-white rounded-xl border border-brand-soft-gray p-6 shadow-sm flex flex-col">
            <div class="flex items-center gap-4 mb-4">
              <img 
                src={testimonial.image} 
                alt={testimonial.name}
                class="w-16 h-16 rounded-full object-cover border-2 border-brand-soft-gray"
              />
              <div>
                <p class="font-bold text-brand-dark">{testimonial.name}</p>
                <p class="text-sm text-brand-medium-gray">{testimonial.company}</p>
                <p class="text-xs text-brand-medium-gray">{testimonial.location}</p>
              </div>
            </div>
            <div class="flex gap-2 mb-4">
              <span class="badge badge-red">{testimonial.industry}</span>
              <span class="badge">{testimonial.result}</span>
            </div>
            <blockquote class="text-brand-medium-gray text-sm leading-relaxed mb-4 flex-1">
              "{testimonial.quote}"
            </blockquote>
            <div class="pt-4 border-t border-brand-soft-gray">
              <p class="text-2xl font-extrabold text-brand-red">{testimonial.metric}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       GEO-GRID RESULTS - Visual Proof
       ============================================ -->
  <section class="bg-white py-20">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="section-label">Visual Proof</p>
          <h2 class="mb-6">See What Map Pack Domination Looks Like</h2>
          <p class="text-brand-medium-gray text-lg leading-relaxed mb-6">
            This is an actual geo-grid result for one of our HVAC clients in Tampa. Green means they rank #1, #2, or #3 in that area. The red star is their business location.
          </p>
          <p class="text-brand-medium-gray leading-relaxed mb-6">
            <strong class="text-brand-dark">Every green circle represents potential customers</strong> who will see our client first when they search for "AC repair near me" or "HVAC company."
          </p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3 text-brand-near-black">
              <svg class="w-5 h-5 text-green-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <strong>23 of 25</strong> grid points ranking in Top 3
            </li>
            <li class="flex items-start gap-3 text-brand-near-black">
              <svg class="w-5 h-5 text-green-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Results achieved in <strong>47 days</strong>
            </li>
            <li class="flex items-start gap-3 text-brand-near-black">
              <svg class="w-5 h-5 text-green-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Using our <strong>Foundation + Accelerator</strong> system
            </li>
          </ul>
          <a href="/services/local-seo/" class="btn-primary">Learn About Our SEO Process</a>
