<script is:inline>
  // Reviews carousel auto-slide & controls
  (function() {
    const track = document.getElementById('reviews-track');
    const prevBtn = document.getElementById('reviews-prev');
    const nextBtn = document.getElementById('reviews-next');
    if (!track) return;

    let scrollPos = 0;
    const cardWidth = 336;
    const maxScroll = track.scrollWidth - track.parentElement.clientWidth;

    function slideTo(pos) {
      scrollPos = Math.max(0, Math.min(pos, maxScroll));
      track.style.transform = `translateX(-${scrollPos}px)`;
    }

    nextBtn?.addEventListener('click', () => slideTo(scrollPos + cardWidth));
    prevBtn?.addEventListener('click', () => slideTo(scrollPos - cardWidth));

    let autoSlide = setInterval(() => {
      if (scrollPos >= maxScroll) {
        slideTo(0);
      } else {
        slideTo(scrollPos + cardWidth);
      }
    }, 7000);

    track.parentElement?.addEventListener('mouseenter', () => clearInterval(autoSlide));
    track.parentElement?.addEventListener('mouseleave', () => {
      autoSlide = setInterval(() => {
        if (scrollPos >= maxScroll) {
          slideTo(0);
        } else {
          slideTo(scrollPos + cardWidth);
        }
      }, 7000);
    });

    let isDragging = false, startX = 0, startScroll = 0;
    track.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.pageX;
      startScroll = scrollPos;
      track.style.cursor = 'grabbing';
    });
    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const diff = startX - e.pageX;
      slideTo(startScroll + diff);
    });
    window.addEventListener('mouseup', () => {
      isDragging = false;
      track.style.cursor = 'grab';
    });
    track.style.cursor = 'grab';
  })();
</script>

