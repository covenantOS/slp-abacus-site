---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/CTASection.astro';
import FAQ from '../components/FAQ.astro';
import IndustryIcon from '../components/IndustryIcon.astro';

const homeFaqs = [
  {
    question: 'What types of home services businesses do you work with?',
    answer: 'We specialize in HVAC, plumbing, roofing, electrical, pest control, garage door, landscaping, and other home services businesses generating $1M+ in annual revenue. Our strategies are built for companies ready to scale — not startups.',
  },
  {
    question: 'What makes ServiceLinePro different from other marketing agencies?',
    answer: 'Three things: First, we exclusively serve home services businesses — we know your customer, your market, and your competition. Second, our <strong>Spectrum partnership</strong> gives clients access to TV and streaming advertising with free professional videography for Florida-based businesses. Third, our <strong>90-day Top 3 Map Pack guarantee</strong> means we put our money where our mouth is.',
  },
  {
    question: 'Do you require long-term contracts?',
    answer: 'No. We offer month-to-month agreements on most services. We do offer a 12-month commitment option that waives setup fees entirely — saving you $1,500–$2,500 upfront — but it\'s your choice. We earn your business every month.',
  },
  {
    question: 'How quickly will I see results?',
    answer: 'It depends on the service. With our <a href="/services/local-seo/">Local SEO Accelerator</a>, many clients see visible movement in their Google Map Pack rankings within 7–10 days. <a href="/services/ppc/">PPC campaigns</a> generate leads from day one. <a href="/services/web-design/">Website projects</a> typically launch within 4–6 weeks.',
  },
  {
    question: 'Do you serve businesses outside of Florida?',
    answer: 'Absolutely. Our headquarters are in Tampa, FL, but we serve home services businesses nationwide. Our Local SEO, PPC, and web design services work in any market. TV/streaming advertising through our Spectrum partnership is available in Spectrum service areas across the country.',
  },
];

const stats = [
  { value: "500+", label: "Keywords Ranked" },
  { value: "47", label: "Avg. Days to Top 3" },
  { value: "$12M+", label: "Revenue Generated" },
  { value: "98%", label: "Client Retention" }
];

const services = [
  {
    title: "Local SEO & Map Pack",
    description: "Lead your local market with our proven Foundation + Accelerator system. We guarantee top 3 Map Pack rankings in 90 days or we work for free.",
    price: "Starting at $1,500/mo",
    href: "/services/local-seo/",
    features: ["90-Day Guarantee", "GBP Optimization", "Citation Building", "Review Management"],
    icon: "search"
  },
  {
    title: "Google Ads & PPC",
    description: "Get leads from day one with expertly managed campaigns. Through our Spectrum partnership, qualified clients pay zero management fees.",
    price: "Custom pricing",
    href: "/services/ppc/",
    features: ["$0 Management Fees*", "Google & Bing Ads", "Landing Page Design", "Call Tracking"],
    icon: "cursor"
  },
  {
    title: "Custom Web Design",
    description: "Lightning-fast Astro or WordPress websites custom-built to convert visitors into booked jobs. No templates. No page builders.",
    price: "Starting at $250/mo",
    href: "/services/web-design/",
    features: ["Mobile-First Design", "SEO Optimized", "Conversion Focused", "CMS Included"],
    icon: "code"
  },
  {
    title: "TV & Streaming Ads",
    description: "Our exclusive Spectrum partnership puts your business on TV and streaming platforms. Florida clients receive complimentary professional videography.",
    price: "Custom pricing",
    href: "/services/tv-streaming/",
    features: ["Free Videography (FL)", "Geo-Targeted Ads", "Cross-Channel", "Brand Building"],
    icon: "tv",
    highlight: true
  }
];

const industries = [
  { name: 'HVAC', slug: 'hvac', href: '/industries/hvac/' },
  { name: 'Plumbing', slug: 'plumbing', href: '/industries/plumbing/' },
  { name: 'Roofing', slug: 'roofing', href: '/industries/roofing/' },
  { name: 'Electrical', slug: 'electrical', href: '/industries/electrical/' },
  { name: 'Pest Control', slug: 'pest-control', href: '/industries/pest-control/' },
  { name: 'Garage Doors', slug: 'garage-doors', href: '/industries/garage-doors/' },
  { name: 'Landscaping', slug: 'landscaping', href: '/industries/landscaping/' },
  { name: 'Pool Services', slug: 'pool-services', href: '/industries/pool-services/' },
];

const caseStudies = [
  {
    title: "Tampa HVAC Company",
    metric: "#1 in Map Pack",
    timeframe: "47 Days",
    industry: "HVAC",
    services: ["Local SEO", "Web Design"]
  },
  {
    title: "Orlando Plumbing Pro",
    metric: "+285% Organic Traffic",
    timeframe: "90 Days",
    industry: "Plumbing",
    services: ["Local SEO", "PPC"]
  },
  {
    title: "Clearwater Roofing",
    metric: "$1.2M New Revenue",
    timeframe: "6 Months",
    industry: "Roofing",
    services: ["TV Ads", "Local SEO"]
  }
];
---

<PageLayout
  title="Digital Marketing for Home Services | Local SEO, PPC, Web Design"
  description="ServiceLinePro — Digital marketing agency for home services businesses doing $1M+. Local SEO with 90-day Top 3 guarantee, Google Ads, custom websites, and TV/streaming ads via our Spectrum partnership. Tampa HQ, national reach."
  canonicalUrl="https://servicelinepro.com/"
>

  <!-- JSON-LD Schema -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness", "ProfessionalService"],
      "name": "ServiceLinePro",
      "url": "https://servicelinepro.com",
      "logo": "https://i.ytimg.com/vi/WdE4QLMESxQ/mqdefault.jpg",
      "description": "Digital marketing agency specializing in Local SEO, PPC, Web Design, and TV/Streaming advertising for home services businesses doing $1M+ annually.",
      "telephone": "+1-813-521-3199",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tampa",
        "addressRegion": "FL",
        "addressCountry": "US"
      },
      "areaServed": { "@type": "Country", "name": "United States" },
      "sameAs": [
        "https://www.facebook.com/servicelinepro",
        "https://www.instagram.com/servicelinepro",
        "https://www.linkedin.com/company/servicelinepro"
      ]
    })} />
  </Fragment>

  <!-- ============================================
       HERO SECTION - Clean, Light, Single CTA
       ============================================ -->
  <section class="bg-brand-off-white min-h-[85vh] flex items-center relative overflow-hidden">
    <!-- Subtle decorative gradient -->
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-brand-soft-red/30 to-transparent pointer-events-none"></div>
    
    <div class="container relative z-10 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Hero Content -->
        <div class="text-container-wide">
          <!-- Partnership Badge -->
          <div class="inline-flex items-center gap-2 bg-white border border-brand-soft-gray rounded-full px-4 py-2 mb-8 shadow-sm">
            <span class="text-brand-red font-semibold text-sm">Spectrum Reach Partner</span>
            <span class="text-brand-medium-gray">•</span>
            <span class="text-brand-medium-gray text-sm">Tampa HQ</span>
          </div>
          
          <h1 class="text-brand-dark leading-tight mb-6">
            Grow Your Local Market.<br />
            <span class="text-brand-red">Build Revenue.</span> <span class="text-brand-gold">Create Legacy.</span>
          </h1>
          
          <p class="text-lg md:text-xl text-brand-medium-gray leading-relaxed mb-8">
            The digital marketing agency built <strong class="text-brand-dark">exclusively for home services businesses</strong> doing $1M+ annually. Local SEO with a 90-day guarantee, Google Ads, custom websites, and TV advertising through our Spectrum partnership.
          </p>
          
          <!-- Single Primary CTA -->
          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="/booking/" class="btn-primary text-lg px-8 py-4">
              Get Your Free Growth Plan →
            </a>
          </div>
          
          <!-- Trust Indicators -->
          <div class="flex flex-wrap items-center gap-4 text-sm text-brand-medium-gray">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              90-Day Guarantee
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              No Contracts
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Tampa-Based
            </span>
          </div>
        </div>
        
        <!-- Hero Form Card -->
        <div class="hidden lg:block">
          <div class="bg-white rounded-2xl shadow-xl border border-brand-soft-gray p-8 max-w-md ml-auto">
            <div class="text-center mb-6">
              <h2 class="text-2xl font-bold text-brand-dark mb-2">Get Your Free Growth Plan</h2>
              <p class="text-brand-medium-gray text-sm">See how we can help you lead your market in 90 days</p>
            </div>
            
            <form id="hero-form" class="space-y-4">
              <input type="text" name="name" placeholder="Your Name" required class="form-input" />
              <input type="email" name="email" placeholder="Email Address" required class="form-input" />
              <input type="tel" name="phone" placeholder="Phone Number" required class="form-input" />
              <select name="industry" class="form-input text-brand-medium-gray">
                <option value="">Select Your Industry</option>
                <option value="hvac">HVAC</option>
                <option value="plumbing">Plumbing</option>
                <option value="roofing">Roofing</option>
                <option value="electrical">Electrical</option>
                <option value="pest-control">Pest Control</option>
                <option value="other">Other Home Services</option>
              </select>
              <select name="service" class="form-input text-brand-medium-gray">
                <option value="">What Are You Interested In?</option>
                <option value="seo">Local SEO & Map Pack</option>
                <option value="ppc">Google Ads / PPC</option>
                <option value="web">Web Design</option>
                <option value="tv">TV & Streaming Ads</option>
                <option value="full">Full Marketing Package</option>
              </select>
              <button type="submit" class="btn-primary w-full text-lg py-4">
                Get My Free Strategy Call →
              </button>
            </form>
            
            <p class="text-center text-xs text-brand-medium-gray mt-4">
              No contracts. No pressure. Just a clear growth plan.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       STATS BAR - Subtle, Light Theme
       ============================================ -->
  <section class="bg-white py-10 border-y border-brand-soft-gray">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map((stat) => (
          <div class="text-center">
            <p class="text-3xl md:text-4xl font-extrabold text-brand-red mb-1">{stat.value}</p>
            <p class="text-brand-medium-gray text-sm font-medium">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       PARTNER CREDIBILITY BAR
       ============================================ -->
  <section class="bg-brand-off-white py-8">
    <div class="container">
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-brand-soft-red rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-brand-red" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <div>
            <p class="text-xs text-brand-medium-gray uppercase tracking-wider">Certified Partner</p>
            <p class="font-bold text-brand-dark">Spectrum Reach</p>
          </div>
        </div>
        <div class="h-8 w-px bg-brand-soft-gray hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg class="h-8 w-8 text-brand-dark" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
          </svg>
          <span class="font-semibold text-brand-dark">Google Partner</span>
        </div>
        <div class="h-8 w-px bg-brand-soft-gray hidden md:block"></div>
        <div class="text-center">
          <p class="text-2xl font-bold text-brand-dark">4.9★</p>
          <p class="text-xs text-brand-medium-gray">Client Rating</p>
        </div>
        <div class="h-8 w-px bg-brand-soft-gray hidden md:block"></div>
        <div class="text-center">
          <p class="text-2xl font-bold text-brand-dark">100+</p>
          <p class="text-xs text-brand-medium-gray">Home Service Clients</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       WHY SERVICELINEPRO - Light Theme
       ============================================ -->
  <section class="bg-white py-20">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <p class="section-label">Why ServiceLinePro</p>
        <h2>Built for Home Services. Backed by Results.</h2>
        <p class="text-brand-medium-gray text-lg mx-auto">
          We don't work with restaurants, dentists, or e-commerce stores. Every strategy, every campaign, and every dollar is focused on helping home services businesses grow.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card card-hover text-center p-8">
          <div class="icon-container icon-container-lg mx-auto mb-6">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3">90-Day Top 3 Guarantee</h3>
          <p class="text-brand-medium-gray text-sm leading-relaxed">
            We guarantee your primary keyword ranks in the top 3 of Google's Map Pack within 90 days — or we work for free until it does.
          </p>
        </div>
        
        <div class="card card-hover text-center p-8">
          <div class="icon-container icon-container-lg mx-auto mb-6" style="background-color: #FEF3C7;">
            <svg class="w-8 h-8 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Exclusive Spectrum Partnership</h3>
          <p class="text-brand-medium-gray text-sm leading-relaxed">
            Put your business on TV and streaming with our direct Spectrum partnership. Florida clients receive <strong>complimentary professional videography</strong>.
          </p>
        </div>
        
        <div class="card card-hover text-center p-8">
          <div class="icon-container icon-container-lg mx-auto mb-6" style="background-color: #F3F4F6;">
            <svg class="w-8 h-8 text-brand-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Home Services Specialists</h3>
          <p class="text-brand-medium-gray text-sm leading-relaxed">
            HVAC, plumbing, roofing, electrical — we know your customer, your competition, and your margins. Strategies built for $1M+ businesses.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       SERVICES - Standardized Cards, Light Theme
       ============================================ -->
  <section class="bg-brand-light-gray py-20">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <p class="section-label">Our Services</p>
        <h2>Four Pillars of Growth</h2>
        <p class="text-brand-medium-gray text-lg mx-auto">
          Every service works independently or as part of a complete growth engine. Most clients stack two or more for maximum market impact.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map((service) => (
          <a href={service.href} class="group bg-white rounded-xl border border-brand-soft-gray hover:border-brand-red hover:shadow-lg transition-all p-6 md:p-8 flex flex-col">
            {service.highlight && (
              <div class="mb-4">
                <span class="badge badge-gold">Spectrum Exclusive</span>
              </div>
            )}
            
            <div class="flex items-start gap-4 mb-4">
              <div class="icon-container shrink-0">
                {service.icon === 'search' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                )}
                {service.icon === 'cursor' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/>
                  </svg>
                )}
                {service.icon === 'code' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                  </svg>
                )}
                {service.icon === 'tv' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                )}
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold text-brand-dark group-hover:text-brand-red transition-colors mb-2">
                  {service.title}
                </h3>
                <p class="text-brand-medium-gray text-sm leading-relaxed line-clamp-2">
                  {service.description}
                </p>
              </div>
            </div>
            
            <div class="flex flex-wrap gap-2 mb-4">
              {service.features.map((feature) => (
                <span class="text-xs bg-brand-light-gray text-brand-dark px-2 py-1 rounded">{feature}</span>
              ))}
            </div>
            
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-brand-soft-gray">
              <span class="text-brand-red font-semibold text-sm">{service.price}</span>
              <span class="text-brand-red font-semibold text-sm group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Learn More <span>→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       CASE STUDIES - Light Theme
       ============================================ -->
  <section class="bg-white py-20">
    <div class="container">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
        <div>
          <p class="section-label">Proven Results</p>
          <h2>Real Clients. Real Results.</h2>
        </div>
        <a href="/case-studies/" class="btn-secondary">View All Case Studies</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {caseStudies.map((study) => (
          <div class="card card-hover p-6">
            <div class="flex items-center gap-2 mb-4">
              <span class="badge badge-red">{study.industry}</span>
            </div>
            <p class="text-3xl font-extrabold text-brand-dark mb-2">{study.metric}</p>
            <p class="text-brand-medium-gray text-sm mb-4">{study.title} • {study.timeframe}</p>
            <div class="flex flex-wrap gap-2">
              {study.services.map((svc) => (
                <span class="text-xs bg-brand-light-gray text-brand-dark px-2 py-1 rounded">{svc}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       INDUSTRIES - Professional Icons, Light Theme
       ============================================ -->
  <section class="bg-brand-off-white py-20">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <p class="section-label">Industries We Serve</p>
        <h2>Marketing That Understands the Trades</h2>
        <p class="text-brand-medium-gray text-lg mx-auto">
          We partner with home services businesses that are already successful and ready to scale. If you're doing $1M+ annually, we're your team.
        </p>
      </div>
      
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {industries.map((industry) => (
          <a href={industry.href} class="card card-hover p-6 text-center">
            <div class="icon-container mx-auto mb-4">
              <IndustryIcon industry={industry.slug} class="w-6 h-6" />
            </div>
            <p class="font-semibold text-brand-dark">{industry.name}</p>
          </a>
        ))}
      </div>
      
      <div class="text-center mt-10">
        <a href="/industries/" class="text-brand-red font-semibold hover:text-brand-coral inline-flex items-center gap-1">
          View All Industries <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================
       SPECTRUM PARTNERSHIP - Clean Callout (No Gimmicky Badge)
       ============================================ -->
  <section class="bg-white py-20">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="relative">
          <img 
            src="/assets/images/team/office-workspace.jpg" 
            alt="ServiceLinePro team working"
            class="rounded-2xl shadow-lg"
          />
