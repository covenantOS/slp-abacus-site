---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/CTASection.astro';
import FAQ from '../components/FAQ.astro';
import IndustryIcon from '../components/IndustryIcon.astro';
import SlidingBanner from '../components/SlidingBanner.astro';
import HeroSurvey from '../components/HeroSurvey.astro';

const homeFaqs = [
  {
    question: 'What types of home services businesses do you work with?',
    answer: 'We specialize in HVAC, plumbing, roofing, electrical, pest control, garage door, landscaping, and other home services businesses generating $1M+ in annual revenue. Our strategies are built for companies ready to scale — not startups.',
  },
  {
    question: 'What makes ServiceLinePro different from other marketing agencies?',
    answer: 'Three things: First, we exclusively serve home services businesses — we know your customer, your market, and your competition. Second, our <strong>Spectrum partnership</strong> gives clients access to TV and streaming advertising with free professional videography for Florida-based businesses. Third, our <strong>90-day Top 3 Map Pack guarantee</strong> means we put our money where our mouth is.',
  },
  {
    question: 'Do you require long-term contracts?',
    answer: 'No. We offer month-to-month agreements on most services. We do offer a 12-month commitment option that waives setup fees entirely — saving you $1,500–$2,500 upfront — but it\'s your choice. We earn your business every month.',
  },
  {
    question: 'How quickly will I see results?',
    answer: 'It depends on the service. With our <a href="/services/local-seo/">Local SEO Accelerator</a>, many clients see visible movement in their Google Map Pack rankings within 7–10 days. <a href="/services/ppc/">PPC campaigns</a> generate leads from day one. <a href="/services/web-design/">Website projects</a> typically launch within 4–6 weeks.',
  },
  {
    question: 'Do you serve businesses outside of Florida?',
    answer: 'Absolutely. Our headquarters are in Tampa, FL, but we serve home services businesses nationwide. Our Local SEO, PPC, and web design services work in any market. TV/streaming advertising through our Spectrum partnership is available in Spectrum service areas across the country.',
  },
];

const services = [
  {
    title: "Local SEO & Map Pack",
    description: "Lead your local market with our proven Foundation + Accelerator system. We guarantee top 3 Map Pack rankings in 90 days or we work for free.",
    price: "Starting at $1,500/mo",
    href: "/services/local-seo/",
    features: ["90-Day Guarantee", "GBP Optimization", "Citation Building", "Review Management"],
    icon: "search"
  },
  {
    title: "Google Ads & PPC",
    description: "Get leads from day one with expertly managed campaigns. Through our Spectrum partnership, qualified clients pay zero management fees.",
    price: "Custom pricing",
    href: "/services/ppc/",
    features: ["$0 Management Fees*", "Google & Bing Ads", "Landing Page Design", "Call Tracking"],
    icon: "cursor"
  },
  {
    title: "Custom Web Design",
    description: "Lightning-fast Astro or WordPress websites custom-built to convert visitors into booked jobs. No templates. No page builders.",
    price: "Starting at $250/mo",
    href: "/services/web-design/",
    features: ["Mobile-First Design", "SEO Optimized", "Conversion Focused", "CMS Included"],
    icon: "code"
  },
  {
    title: "TV & Streaming Ads",
    description: "Our exclusive Spectrum partnership puts your business on TV and streaming platforms. Florida clients receive complimentary professional videography.",
    price: "Custom pricing",
    href: "/services/tv-streaming/",
    features: ["Free Videography (FL)", "Geo-Targeted Ads", "Cross-Channel", "Brand Building"],
    icon: "tv",
    highlight: true
  }
];

const industries = [
  { name: 'HVAC', slug: 'hvac', href: '/industries/hvac/' },
  { name: 'Plumbing', slug: 'plumbing', href: '/industries/plumbing/' },
  { name: 'Roofing', slug: 'roofing', href: '/industries/roofing/' },
  { name: 'Electrical', slug: 'electrical', href: '/industries/electrical/' },
  { name: 'Pest Control', slug: 'pest-control', href: '/industries/pest-control/' },
  { name: 'Garage Doors', slug: 'garage-doors', href: '/industries/garage-doors/' },
  { name: 'Landscaping', slug: 'landscaping', href: '/industries/landscaping/' },
  { name: 'Pool Services', slug: 'pool-services', href: '/industries/pool-services/' },
];

const guaranteeTerms = [
  "Primary keyword must be achievable (we'll assess during strategy call)",
  "Client maintains 4+ star Google rating during campaign",
  "Client responds to review requests within 48 hours",
  "No other SEO providers working on the same properties",
  "Google Business Profile access provided within 3 business days"
];

/* Case Study data for the two large cards */
const caseStudyCards = [
  {
    company: "Tampa Bay HVAC Co.",
    industry: "HVAC",
    tagColor: "#cf312b",
    quoteColor: "#cf312b",
    image: "/assets/images/services/seo-dashboard.png",
    quote: "ServiceLinePro got us to #1 in the Map Pack in under 50 days. Our phone volume doubled almost overnight.",
    quoteName: "Mike J., Owner",
    metric1: { value: "+427%", label: "Top 10 Keywords" },
    metric2: { value: "+68%", label: "Organic Conversions" },
    description: "A mid-size HVAC company in Tampa struggling to compete in a saturated market. Within 47 days of launching the Foundation + Accelerator plan, they reached #1 for their primary keyword.",
    href: "/case-studies/"
  },
  {
    company: "Premier Plumbing Pro",
    industry: "Plumbing",
    tagColor: "#62c2dc",
    quoteColor: "#0e7490",
    image: "/assets/images/services/seo-dashboard.png",
    quote: "The Spectrum TV partnership combined with SEO made us the most recognized plumber in Central Florida. Game changer.",
    quoteName: "Robert C., CEO",
    metric1: { value: "+285%", label: "Organic Traffic" },
    metric2: { value: "$1.8M", label: "Revenue Generated" },
    description: "A plumbing company in Orlando that paired Local SEO with TV & Streaming advertising to dominate their market across three cities in 6 months.",
    href: "/case-studies/"
  }
];

/* Reviews data */
const reviews = [
  { name: "Mike Johnson", rating: 5, text: "Went from page 3 to #1 in the Map Pack in 47 days. Our phone hasn't stopped ringing since.", business: "HVAC Company" },
  { name: "Robert Chen", rating: 5, text: "The combination of SEO and TV advertising has completely transformed our plumbing business. Best investment we've made.", business: "Plumbing Service" },
  { name: "David Martinez", rating: 5, text: "I was skeptical about the 90-day guarantee, but they delivered. Now we're dominating 3 cities.", business: "Roofing Company" },
  { name: "Sarah Williams", rating: 5, text: "Professional, transparent, and they actually deliver results. No more wasted money on agencies that overpromise.", business: "Electrical Contractor" },
  { name: "James Peterson", rating: 5, text: "The custom website they built converts 3x better than our old one. Plus the SEO has us ranking everywhere.", business: "Pest Control" },
  { name: "Tom Bradley", rating: 5, text: "Free videography through the Spectrum partnership was incredible. Our TV commercial looks amazing.", business: "Garage Door Service" },
];
---

<PageLayout
  title="Digital Marketing for Home Services | Local SEO, PPC, Web Design"
  description="ServiceLinePro — Digital marketing agency for home services businesses doing $1M+. Local SEO with 90-day Top 3 guarantee, Google Ads, custom websites, and TV/streaming ads via our Spectrum partnership. Tampa HQ, national reach."
  canonicalUrl="https://servicelinepro.com/"
>

  <!-- JSON-LD Schema -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness", "ProfessionalService"],
      "name": "ServiceLinePro",
      "url": "https://servicelinepro.com",
      "logo": "https://i.ytimg.com/vi/WdE4QLMESxQ/maxresdefault.jpg",
      "description": "Digital marketing agency specializing in Local SEO, PPC, Web Design, and TV/Streaming advertising for home services businesses doing $1M+ annually.",
      "telephone": "+1-813-521-3199",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tampa",
        "addressRegion": "FL",
        "addressCountry": "US"
      },
      "founder": {
        "@type": "Person",
        "name": "Will Hamilton",
        "jobTitle": "CEO & Founder"
      },
      "areaServed": { "@type": "Country", "name": "United States" },
      "sameAs": [
        "https://www.facebook.com/servicelinepro",
        "https://www.instagram.com/servicelinepro",
        "https://www.linkedin.com/company/servicelinepro"
      ]
    })} />
  </Fragment>

  <!-- ============================================
       1. SLIDING BANNER (above header)
       ============================================ -->
  <SlidingBanner slot="banner" />

  <!-- ============================================
       3. HERO SECTION
       ============================================ -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden" style="background: linear-gradient(135deg, #0f0a06 0%, #1a1410 50%, #0f0a06 100%);">
    <!-- Background image with overlay -->
    <div class="absolute inset-0">
      <img 
        src="/assets/images/hero/hvac-technician-hero.jpg" 
        alt="Digital marketing professionals collaborating on strategy"
        class="w-full h-full object-cover opacity-15"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0f0a06] via-[#0f0a06]/80 to-[#0f0a06]/60"></div>
    </div>
    
    <div class="container relative z-10 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Hero Content -->
        <div>
          <!-- Partnership Logos Row -->
          <div class="flex items-center gap-5 mb-8">
            <!-- Google Partner Logo -->
            <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/10 rounded-lg px-3 py-2">
              <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
              </svg>
              <span class="text-white text-xs font-semibold">Google Partner</span>
            </div>
            <!-- Spectrum Logo -->
            <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/10 rounded-lg px-3 py-2">
              <svg class="h-5 w-5 text-brand-light-blue" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
              <span class="text-white text-xs font-semibold">Spectrum</span>
            </div>
            <!-- SLP Logo -->
            <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/10 rounded-lg px-3 py-2">
              <div class="w-5 h-5 bg-brand-red rounded flex items-center justify-center">
                <span class="text-white text-[8px] font-black">SLP</span>
              </div>
              <span class="text-white text-xs font-semibold">ServiceLinePro</span>
            </div>
          </div>
          
          <h1 class="text-white leading-tight mb-6" style="font-size: clamp(2.25rem, 5vw, 3.75rem);">
            Local SEO & Google Ads<br />
            <span class="text-brand-light-blue">That Actually Grow</span><br />
            Your Business.
          </h1>
          
          <p class="text-lg md:text-xl text-white/70 leading-relaxed mb-8 max-w-xl">
            The digital marketing agency built <strong class="text-white">exclusively for home services businesses</strong> doing $1M+ annually. 90-day Map Pack guarantee. No contracts. Real results.
          </p>
          
          <!-- TWO Main Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="/booking/" class="btn-primary text-lg px-8 py-4">
              Book Strategy Call →
            </a>
            <a href="/booking/" class="btn-accent text-lg px-8 py-4">
              Get a Free Growth Plan
            </a>
          </div>
          
          <!-- Trust Indicators -->
          <div class="flex flex-wrap items-center gap-4 text-sm text-white/60">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-light-blue" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              90-Day Guarantee
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-light-blue" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              No Contracts
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-light-blue" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Tampa-Based
            </span>
          </div>
        </div>
        
        <!-- 4. HERO FORM → Multi-Step Survey -->
        <div class="hidden lg:block">
          <HeroSurvey />
        </div>
      </div>
    </div>

    <!-- Chat Widget Placeholder (bottom right) -->
    <button id="chat-widget" class="fixed bottom-6 right-6 z-50 bg-brand-light-blue hover:bg-brand-light-blue-dark text-brand-dark font-bold px-5 py-3 rounded-full shadow-xl flex items-center gap-2 transition-all hover:scale-105 lg:bottom-8 lg:right-8" aria-label="Text us">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
      </svg>
      Text Us
    </button>
  </section>

  <!-- ============================================
       5. AUTHORITY BANNER (below hero)
       ============================================ -->
  <section class="relative py-10 overflow-hidden" style="background: #0f0a06; border-top: 2px solid #81dde3; border-bottom: 2px solid #81dde3;">
    <div class="container">
      <!-- TOP ROW: Trust Signals -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 text-center mb-8">
        <div class="flex flex-col items-center gap-2">
          <svg class="w-8 h-8 text-brand-light-blue" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
          </svg>
          <p class="text-white font-bold text-lg md:text-xl">Google Certified</p>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="flex text-brand-gold">
            {[1,2,3,4,5].map(() => (
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-white font-bold text-lg md:text-xl">5.0 Star Rated</p>
        </div>
        <div class="flex flex-col items-center gap-2">
          <svg class="w-8 h-8 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <p class="text-white font-bold text-lg md:text-xl">TAG Certified</p>
        </div>
        <div class="flex flex-col items-center gap-2">
          <svg class="w-8 h-8 text-brand-light-blue" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
          <p class="text-white font-bold text-lg md:text-xl">Google Partner</p>
        </div>
      </div>

      <!-- Divider -->
      <div class="h-px w-full bg-white/10 mb-8"></div>

      <!-- BOTTOM ROW: Partner Logos -->
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-14">
        <!-- Google -->
        <div class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity">
          <svg class="h-7 w-auto text-white" viewBox="0 0 272 92" fill="currentColor">
            <path d="M115.75 47.18c0 12.77-9.99 22.18-22.25 22.18s-22.25-9.41-22.25-22.18C71.25 34.32 81.24 25 93.5 25s22.25 9.32 22.25 22.18zm-9.74 0c0-7.98-5.79-13.44-12.51-13.44S80.99 39.2 80.99 47.18c0 7.9 5.79 13.44 12.51 13.44s12.51-5.55 12.51-13.44z"/>
            <path d="M163.75 47.18c0 12.77-9.99 22.18-22.25 22.18s-22.25-9.41-22.25-22.18c0-12.85 9.99-22.18 22.25-22.18s22.25 9.32 22.25 22.18zm-9.74 0c0-7.98-5.79-13.44-12.51-13.44s-12.51 5.46-12.51 13.44c0 7.9 5.79 13.44 12.51 13.44s12.51-5.55 12.51-13.44z"/>
            <path d="M209.75 26.34v39.82c0 16.38-9.66 23.07-21.08 23.07-10.75 0-17.22-7.19-19.66-13.07l8.48-3.53c1.51 3.61 5.21 7.87 11.17 7.87 7.31 0 11.84-4.51 11.84-13v-3.19h-.34c-2.18 2.69-6.38 5.04-11.68 5.04-11.09 0-21.25-9.66-21.25-22.09 0-12.52 10.16-22.26 21.25-22.26 5.29 0 9.49 2.35 11.68 4.96h.34v-3.61h9.25zm-8.56 20.92c0-7.81-5.21-13.52-11.84-13.52-6.72 0-12.35 5.71-12.35 13.52 0 7.73 5.63 13.36 12.35 13.36 6.63 0 11.84-5.63 11.84-13.36z"/>
            <path d="M225 3v65h-9.5V3h9.5z"/>
            <path d="M262.02 54.48l7.56 5.04c-2.44 3.61-8.32 9.83-18.48 9.83-12.6 0-22.01-9.74-22.01-22.18 0-13.19 9.49-22.18 20.92-22.18 11.51 0 17.14 9.16 18.98 14.11l1.01 2.52-29.65 12.28c2.27 4.45 5.8 6.72 10.75 6.72 4.96 0 8.4-2.44 10.92-6.14zm-23.27-7.98l19.82-8.23c-1.09-2.77-4.37-4.7-8.23-4.7-4.95 0-11.84 4.37-11.59 12.93z"/>
            <path d="M35.29 41.19V32H67c.31 1.64.47 3.58.47 5.68 0 7.06-1.93 15.79-8.15 22.01-6.05 6.3-13.78 9.66-24.02 9.66C16.32 69.35.36 53.89.36 34.91.36 15.93 16.32.47 35.3.47c10.5 0 17.98 4.12 23.6 9.49l-6.64 6.64c-4.03-3.78-9.49-6.72-16.97-6.72-13.86 0-24.7 11.17-24.7 25.03 0 13.86 10.84 25.03 24.7 25.03 8.99 0 14.11-3.61 17.39-6.89 2.66-2.66 4.41-6.46 5.1-11.65l-22.49-.21z"/>
          </svg>
        </div>
        <!-- Spectrum -->
        <div class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity">
          <span class="text-white font-bold text-xl tracking-wider" style="font-family: var(--font-heading);">SPECTRUM</span>
          <span class="text-brand-light-blue text-xs font-semibold bg-brand-light-blue/10 px-2 py-0.5 rounded">Reach</span>
        </div>
        <!-- ServiceTitan -->
        <div class="opacity-70 hover:opacity-100 transition-opacity">
          <span class="text-white font-bold text-lg" style="font-family: var(--font-heading);">ServiceTitan</span>
        </div>
        <!-- Housecall Pro -->
        <div class="opacity-70 hover:opacity-100 transition-opacity">
          <span class="text-white font-bold text-lg" style="font-family: var(--font-heading);">Housecall Pro</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       6. CASE STUDIES SECTION (2 large cards side by side)
       ============================================ -->
  <section class="bg-brand-off-white py-20">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <p class="section-label">Proven Results</p>
        <h2>Case Studies That Speak for Themselves</h2>
        <p class="text-brand-medium-gray text-lg mx-auto">
          Real businesses. Real numbers. See how we drive growth for home services companies.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {caseStudyCards.map((cs) => (
          <div class="bg-white rounded-2xl overflow-hidden border border-brand-soft-gray shadow-sm hover:shadow-lg transition-all group">
            <!-- Image area with company tag -->
            <div class="relative aspect-video overflow-hidden bg-brand-light-gray">
              <img src={cs.image} alt={cs.company} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
              <!-- Company name tag (bottom-left) -->
              <div class="absolute bottom-3 left-3">
                <span class="px-3 py-1.5 rounded-lg text-white text-sm font-bold backdrop-blur-sm" style={`background-color: ${cs.tagColor}80;`}>
                  {cs.company}
                </span>
              </div>
              <!-- Industry badge -->
              <div class="absolute top-3 right-3">
                <span class="px-2 py-1 rounded text-white text-xs font-semibold bg-black/50 backdrop-blur-sm">
                  {cs.industry}
                </span>
              </div>
            </div>

            <!-- Accent color quote banner -->
            <div class="px-6 py-4" style={`background-color: ${cs.quoteColor};`}>
              <p class="text-white text-sm italic leading-relaxed">"{cs.quote}"</p>
              <p class="text-white/80 text-xs font-semibold mt-1">— {cs.quoteName}</p>
            </div>

            <!-- Metrics row -->
            <div class="px-6 py-5">
              <div class="flex items-center">
