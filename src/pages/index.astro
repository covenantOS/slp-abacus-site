---
import PageLayout from '../layouts/PageLayout.astro';
import TrustSignals from '../components/TrustSignals.astro';
import CTASection from '../components/CTASection.astro';
import FAQ from '../components/FAQ.astro';

const homeFaqs = [
  {
    question: 'What types of home services businesses do you work with?',
    answer: 'We specialize in HVAC, plumbing, roofing, electrical, pest control, garage door, landscaping, and other home services businesses generating $1M+ in annual revenue. Our strategies are built for companies ready to scale — not startups.',
  },
  {
    question: 'What makes ServiceLinePro different from other marketing agencies?',
    answer: 'Three things: First, we exclusively serve home services businesses — we know your customer, your market, and your competition. Second, our <strong>Spectrum partnership</strong> gives clients access to TV and streaming advertising with free professional videography for Florida-based businesses. Third, our <strong>90-day Top 3 Map Pack guarantee</strong> means we put our money where our mouth is.',
  },
  {
    question: 'Do you require long-term contracts?',
    answer: 'No. We offer month-to-month agreements on most services. We do offer a 12-month commitment option that waives setup fees entirely — saving you $1,500–$2,500 upfront — but it\'s your choice. We earn your business every month.',
  },
  {
    question: 'How quickly will I see results?',
    answer: 'It depends on the service. With our <a href="/services/local-seo/">Local SEO Accelerator</a>, many clients see visible movement in their Google Map Pack rankings within 7–10 days. <a href="/services/google-ads/">PPC campaigns</a> generate leads from day one. <a href="/services/web-design/">Website projects</a> typically launch within 4–6 weeks.',
  },
  {
    question: 'Do you serve businesses outside of Florida?',
    answer: 'Absolutely. Our headquarters are in Tampa, FL, but we serve home services businesses nationwide. Our Local SEO, PPC, and web design services work in any market. TV/streaming advertising through our Spectrum partnership is available in Spectrum service areas across the country.',
  },
];
---

<PageLayout
  title="Home"
  description="ServiceLinePro — Digital marketing agency for home services businesses doing $1M+. Local SEO with 90-day Top 3 guarantee, Google Ads, custom websites, and TV/streaming ads via our Spectrum partnership. Tampa HQ, national reach."
  canonicalUrl="https://servicelinepro.com/"
>

  <!-- JSON-LD Schema: Organization + LocalBusiness -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness", "ProfessionalService"],
      "name": "ServiceLinePro",
      "url": "https://servicelinepro.com",
      "logo": "https://i.ytimg.com/vi/WdE4QLMESxQ/maxresdefault.jpg",
      "image": "https://images.template.net/256546/digital-marketing-agency-service-infographic-template-3h4ma.png",
      "description": "Digital marketing agency specializing in Local SEO, PPC, Web Design, and TV/Streaming advertising for home services businesses doing $1M+ annually.",
      "telephone": "+1-813-000-0000",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tampa",
        "addressRegion": "FL",
        "addressCountry": "US"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United States"
      },
      "sameAs": [
        "https://www.facebook.com/servicelinepro",
        "https://www.instagram.com/servicelinepro",
        "https://www.linkedin.com/company/servicelinepro"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Digital Marketing Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Local SEO", "url": "https://servicelinepro.com/services/local-seo/" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Google Ads / PPC", "url": "https://servicelinepro.com/services/google-ads/" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Design", "url": "https://servicelinepro.com/services/web-design/" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "TV & Streaming Advertising", "url": "https://servicelinepro.com/services/tv-streaming/" } }
        ]
      }
    })} />
  </Fragment>

  <!-- Hero Section -->
  <section class="section-dark relative overflow-hidden">
    <div class="container py-24 lg:py-36 relative z-10">
      <div class="max-w-3xl">
        <p class="text-brand-gold font-semibold text-sm tracking-widest uppercase mb-4 font-[family-name:var(--font-ui)]">
          Exclusive Spectrum Partner &bull; Tampa-Based &bull; National Reach
        </p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
          Dominate Your Local Market.<br />
          <span class="text-gradient">Grow Revenue. Build Legacy.</span>
        </h1>
        <p class="text-lg md:text-xl text-brand-medium-gray leading-relaxed mb-8 max-w-2xl">
          ServiceLinePro is the digital marketing agency built exclusively for home services businesses doing $1M+ annually. We combine <strong class="text-white">Local SEO</strong>, <strong class="text-white">Google Ads</strong>, <strong class="text-white">custom websites</strong>, and <strong class="text-white">TV/streaming advertising</strong> through our exclusive Spectrum partnership to help you own your market — and keep it.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/booking/" class="btn-primary text-lg">
            Book a Free Strategy Call
          </a>
          <a href="/services/local-seo/" class="btn-secondary text-lg">
            See Our SEO Guarantee
          </a>
        </div>
        <p class="text-brand-medium-gray text-sm mt-6 font-[family-name:var(--font-ui)]">
          ✓ No contracts required &nbsp;&bull;&nbsp; ✓ 90-day Top 3 guarantee &nbsp;&bull;&nbsp; ✓ Free 10-day ranking boost
        </p>
      </div>
    </div>
    <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-brand-dark to-brand-red/10 pointer-events-none"></div>
    <!-- Hero background image -->
    <div class="absolute top-0 right-0 w-1/2 h-full opacity-10 bg-[url('/assets/images/seo-revenue-dashboard.webp')] bg-cover bg-center pointer-events-none hidden lg:block"></div>
  </section>

  <!-- Trust Signals Bar -->
  <TrustSignals dark={true} />

  <!-- Why ServiceLinePro -->
  <section class="section-light py-20">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <p class="text-brand-red font-semibold text-sm tracking-widest uppercase mb-3 font-[family-name:var(--font-ui)]">Why ServiceLinePro</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Built for Home Services.<br/>Backed by Results.</h2>
        <p class="text-brand-near-black/60 text-lg">
          We don't work with restaurants, dentists, or e-commerce stores. Every strategy, every campaign, and every dollar is focused on one thing: helping home services businesses grow revenue and build lasting market dominance. Our Tampa-based team understands the trades because we serve the trades — exclusively.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 text-center">
          <div class="w-16 h-16 bg-brand-red/10 rounded-full flex items-center justify-center mx-auto mb-5">
            <svg class="w-8 h-8 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Exclusive Spectrum Partnership</h3>
          <p class="text-brand-near-black/60 text-sm leading-relaxed">
            We're one of the few agencies with a direct Spectrum partnership, giving your business access to TV and streaming advertising at rates and targeting capabilities unavailable anywhere else. Florida clients get <strong>free professional videography</strong>.
          </p>
        </div>
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 text-center">
          <div class="w-16 h-16 bg-brand-red/10 rounded-full flex items-center justify-center mx-auto mb-5">
            <svg class="w-8 h-8 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">90-Day Top 3 Guarantee</h3>
          <p class="text-brand-near-black/60 text-sm leading-relaxed">
            We guarantee your primary keyword ranks in the top 3 of the Google Map Pack within 90 days — or we work for free until it does. No refund games. Real accountability. That's how confident we are in our <a href="/services/local-seo/" class="text-brand-red font-semibold">Local SEO system</a>.
          </p>
        </div>
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 text-center">
          <div class="w-16 h-16 bg-brand-red/10 rounded-full flex items-center justify-center mx-auto mb-5">
            <svg class="w-8 h-8 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Home Services Specialists</h3>
          <p class="text-brand-near-black/60 text-sm leading-relaxed">
            HVAC, plumbing, roofing, electrical, pest control, garage doors, landscaping — we know your customer, your competition, and your margins. Our strategies are built for businesses doing $1M+ that are ready to scale to the next level.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services Section -->
  <section class="bg-white py-20">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <p class="text-brand-red font-semibold text-sm tracking-widest uppercase mb-3 font-[family-name:var(--font-ui)]">Our Services</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Four Pillars of Growth</h2>
        <p class="text-brand-near-black/60 text-lg">
          Every service is designed to work independently or as part of a complete growth engine. Most of our clients stack two or more for maximum market penetration.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Local SEO -->
        <div class="bg-brand-light-gray rounded-xl p-8 border border-gray-100 hover:shadow-lg transition-shadow group">
          <div class="flex items-start gap-5">
            <div class="w-14 h-14 bg-brand-red/10 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-7 h-7 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2 group-hover:text-brand-red transition-colors">Local SEO &amp; Map Pack Domination</h3>
              <p class="text-brand-near-black/60 text-sm leading-relaxed mb-3">
                Our Foundation + Accelerator system builds permanent ranking authority while pushing you into the top 3 of Google's Map Pack — fast. Visible movement in as little as 7–10 days. We back it with a <strong>90-day Top 3 guarantee</strong>.
              </p>
              <p class="text-brand-near-black/40 text-sm mb-4">Starting at $1,500/month</p>
              <a href="/services/local-seo/" class="text-brand-red font-semibold text-sm hover:text-brand-coral inline-flex items-center gap-1">
                Build Your SEO Plan <span class="text-lg">&rarr;</span>
              </a>
            </div>
          </div>
        </div>

        <!-- PPC -->
        <div class="bg-brand-light-gray rounded-xl p-8 border border-gray-100 hover:shadow-lg transition-shadow group">
          <div class="flex items-start gap-5">
            <div class="w-14 h-14 bg-brand-red/10 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-7 h-7 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2 group-hover:text-brand-red transition-colors">Google Ads &amp; PPC Management</h3>
              <p class="text-brand-near-black/60 text-sm leading-relaxed mb-3">
                Get leads from day one with expertly managed Google, Bing, and Yahoo ad campaigns. Through our Spectrum partnership, qualified clients access exclusive no-management-fee programs — your ad spend goes further, period.
              </p>
              <p class="text-brand-near-black/40 text-sm mb-4">Custom pricing based on ad spend</p>
              <a href="/services/google-ads/" class="text-brand-red font-semibold text-sm hover:text-brand-coral inline-flex items-center gap-1">
                Learn About PPC <span class="text-lg">&rarr;</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Web Design -->
        <div class="bg-brand-light-gray rounded-xl p-8 border border-gray-100 hover:shadow-lg transition-shadow group">
          <div class="flex items-start gap-5">
            <div class="w-14 h-14 bg-brand-red/10 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-7 h-7 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2 group-hover:text-brand-red transition-colors">Custom Web Design</h3>
              <p class="text-brand-near-black/60 text-sm leading-relaxed mb-3">
                Choose between lightning-fast Astro websites (our recommendation) or powerful WordPress sites. Both are custom-built, conversion-optimized, and designed to turn visitors into booked jobs. No templates. No page builders.
              </p>
              <p class="text-brand-near-black/40 text-sm mb-4">Starting at $250/month or $2,500 upfront</p>
              <a href="/services/web-design/" class="text-brand-red font-semibold text-sm hover:text-brand-coral inline-flex items-center gap-1">
                Compare Web Design Options <span class="text-lg">&rarr;</span>
              </a>
            </div>
          </div>
        </div>

        <!-- TV & Streaming -->
        <div class="bg-brand-light-gray rounded-xl p-8 border border-gray-100 hover:shadow-lg transition-shadow group relative">
          <div class="absolute top-4 right-4 bg-brand-gold text-brand-dark text-xs font-bold px-3 py-1 rounded-full font-[family-name:var(--font-ui)]">
            EXCLUSIVE
          </div>
          <div class="flex items-start gap-5">
            <div class="w-14 h-14 bg-brand-red/10 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-7 h-7 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2 group-hover:text-brand-red transition-colors">TV &amp; Streaming Advertising</h3>
              <p class="text-brand-near-black/60 text-sm leading-relaxed mb-3">
                Our exclusive Spectrum partnership puts your business on TV and streaming platforms — targeted to your exact service area. Florida-based clients get <strong>free professional videography</strong> to produce broadcast-quality commercials. This is a differentiator no other digital agency can offer.
              </p>
              <p class="text-brand-near-black/40 text-sm mb-4">Custom pricing · Free videography (FL)</p>
              <a href="/services/tv-streaming/" class="text-brand-red font-semibold text-sm hover:text-brand-coral inline-flex items-center gap-1">
                Explore TV &amp; Streaming <span class="text-lg">&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Spectrum Partnership Spotlight -->
  <section class="section-dark py-20 relative overflow-hidden">
    <div class="container relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-brand-gold font-semibold text-sm tracking-widest uppercase mb-3 font-[family-name:var(--font-ui)]">Our Competitive Edge</p>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
            The Spectrum Partnership:<br/>Your Unfair Advantage
          </h2>
          <p class="text-brand-medium-gray text-lg leading-relaxed mb-6">
            Most digital agencies can run Google Ads and do SEO. Only ServiceLinePro can put your business on television and streaming platforms through our direct partnership with Spectrum — the largest cable provider in America.
          </p>
          <ul class="space-y-4 mb-8">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-brand-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-white">Targeted TV ads in your exact service area — not wasted impressions across the entire market</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-brand-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-white">Streaming placements on platforms your customers already watch daily</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-brand-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-white"><strong>Free professional videography</strong> for Florida-based clients — broadcast-quality commercials at no extra cost</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-brand-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-white">Combine with SEO and PPC for a multi-channel growth strategy that dominates local competition</span>
            </li>
          </ul>
          <a href="/booking/" class="btn-primary">Ask About TV &amp; Streaming</a>
        </div>
        <div class="relative">
          <img
            src="/assets/images/ads-revenue-dashboard.webp"
            alt="ServiceLinePro advertising performance dashboard showing revenue growth"
            class="rounded-xl shadow-2xl"
            width="600"
            height="400"
            loading="lazy"
          />
          <div class="absolute -bottom-4 -left-4 bg-brand-red text-white p-4 rounded-xl shadow-lg">
            <p class="text-2xl font-extrabold">FREE</p>
            <p class="text-sm">Videography<br/>for FL Clients</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries We Serve -->
  <section class="bg-white py-20">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <p class="text-brand-red font-semibold text-sm tracking-widest uppercase mb-3 font-[family-name:var(--font-ui)]">Industries We Serve</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Marketing That Understands the Trades</h2>
        <p class="text-brand-near-black/60 text-lg">
          We work with home services businesses that are already successful and want to dominate. If you're doing $1M+ annually and want to own your local market, we're your team.
        </p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {[
          { name: 'HVAC', icon: '🌡️' },
          { name: 'Plumbing', icon: '🔧' },
          { name: 'Roofing', icon: '🏠' },
          { name: 'Electrical', icon: '⚡' },
          { name: 'Pest Control', icon: '🛡️' },
          { name: 'Garage Doors', icon: '🚪' },
          { name: 'Landscaping', icon: '🌿' },
          { name: 'Pool Services', icon: '🏊' },
        ].map((industry) => (
          <a href={`/industries/${industry.name.toLowerCase().replace(/\s+/g, '-')}/`} class="bg-brand-light-gray rounded-xl p-6 text-center hover:shadow-md transition-all hover:-translate-y-1 border border-gray-100 group">
            <span class="text-3xl block mb-2">{industry.icon}</span>
            <p class="font-semibold text-brand-dark group-hover:text-brand-red transition-colors">{industry.name}</p>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/industries/" class="text-brand-red font-semibold hover:text-brand-coral inline-flex items-center gap-1">
          View All Industries <span class="text-lg">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- American Values Section -->
  <section class="bg-brand-soft-red py-16">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">American-Built. American-Owned. American Values.</h2>
        <p class="text-brand-near-black/70 text-lg leading-relaxed mb-4">
          ServiceLinePro is a proudly American company headquartered in Tampa, Florida. We believe in hard work, honest business, and delivering real results — not excuses. Our team is based right here in the United States, and every strategy we build reflects the values of the business owners we serve: integrity, accountability, and an unrelenting drive to win.
        </p>
        <p class="text-brand-near-black/70 text-lg leading-relaxed">
          When you work with us, you work with people who understand what it means to build something with your own two hands. We respect the trades. We respect your investment. And we'll work every single day to earn your trust.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQ items={homeFaqs} headline="Got Questions? We've Got Answers." />

  <!-- Final CTA -->
  <CTASection
    headline="Your Competitors Are Already Marketing. Are You?"
    subheadline="Every day you wait is a day your competition captures more of your market. Let's change that. Book a free strategy call — we'll audit your online presence, analyze your competition, and build a custom growth plan."
    buttonText="Book Your Free Strategy Call"
    buttonHref="/booking/"
    secondaryText="Call Us: (813) 000-0000"
    secondaryHref="tel:+18130000000"
  />

</PageLayout>
