---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/CTASection.astro';
import FAQ from '../components/FAQ.astro';

const homeFaqs = [
  {
    question: 'What types of home services businesses do you work with?',
    answer: 'We specialize in HVAC, plumbing, roofing, electrical, pest control, garage door, landscaping, and other home services businesses generating $1M+ in annual revenue. Our strategies are built for companies ready to scale — not startups.',
  },
  {
    question: 'What makes ServiceLinePro different from other marketing agencies?',
    answer: 'Three things: First, we exclusively serve home services businesses — we know your customer, your market, and your competition. Second, our <strong>Spectrum partnership</strong> gives clients access to TV and streaming advertising with free professional videography for Florida-based businesses. Third, our <strong>90-day Top 3 Map Pack guarantee</strong> means we put our money where our mouth is.',
  },
  {
    question: 'Do you require long-term contracts?',
    answer: 'No. We offer month-to-month agreements on most services. We do offer a 12-month commitment option that waives setup fees entirely — saving you $1,500–$2,500 upfront — but it\'s your choice. We earn your business every month.',
  },
  {
    question: 'How quickly will I see results?',
    answer: 'It depends on the service. With our <a href="/services/local-seo/">Local SEO Accelerator</a>, many clients see visible movement in their Google Map Pack rankings within 7–10 days. <a href="/services/ppc/">PPC campaigns</a> generate leads from day one. <a href="/services/web-design/">Website projects</a> typically launch within 4–6 weeks.',
  },
  {
    question: 'Do you serve businesses outside of Florida?',
    answer: 'Absolutely. Our headquarters are in Tampa, FL, but we serve home services businesses nationwide. Our Local SEO, PPC, and web design services work in any market. TV/streaming advertising through our Spectrum partnership is available in Spectrum service areas across the country.',
  },
];

const testimonials = [
  {
    quote: "ServiceLinePro got us to #1 in the Map Pack in just 47 days. Our phone hasn't stopped ringing since. Best marketing investment we've ever made.",
    author: "Mike Rodriguez",
    title: "Owner, Tampa Bay HVAC",
    image: "/assets/images/testimonials/testimonial-1.jpg",
    metric: "+340% leads"
  },
  {
    quote: "The Spectrum TV campaign combined with their SEO work has been a game-changer. We're now the most recognized name in our market.",
    author: "Sarah Chen",
    title: "CEO, Premier Plumbing",
    image: "/assets/images/testimonials/testimonial-2.jpg",
    metric: "#1 in 3 cities"
  },
  {
    quote: "No contracts, real results, and they actually understand the home services industry. Wish I'd found them years ago.",
    author: "James Morrison",
    title: "Owner, Morrison Roofing",
    image: "/assets/images/testimonials/testimonial-1.jpg",
    metric: "2x revenue"
  }
];

const caseStudies = [
  {
    title: "Tampa HVAC Company",
    metric: "#1 in Map Pack",
    timeframe: "47 Days",
    industry: "HVAC",
    services: ["Local SEO", "Web Design"],
    image: "/assets/images/services/seo-dashboard.png"
  },
  {
    title: "Orlando Plumbing Pro",
    metric: "+285% Organic Traffic",
    timeframe: "90 Days",
    industry: "Plumbing",
    services: ["Local SEO", "PPC"],
    image: "/assets/images/services/plumber-working.jpg"
  },
  {
    title: "Clearwater Roofing",
    metric: "$1.2M New Revenue",
    timeframe: "6 Months",
    industry: "Roofing",
    services: ["TV Ads", "Local SEO"],
    image: "/assets/images/services/roofing-contractor.jpg"
  }
];

const stats = [
  { value: "500+", label: "Keywords Ranked", icon: "📈" },
  { value: "47", label: "Avg. Days to Top 3", icon: "⚡" },
  { value: "$12M+", label: "Revenue Generated", icon: "💰" },
  { value: "98%", label: "Client Retention", icon: "🏆" }
];

const services = [
  {
    title: "Local SEO & Map Pack",
    description: "Dominate your local market with our proven Foundation + Accelerator system. We guarantee top 3 Map Pack rankings in 90 days or we work for free.",
    price: "Starting at $1,500/mo",
    href: "/services/local-seo/",
    image: "/assets/images/services/seo-dashboard.png",
    features: ["90-Day Guarantee", "GBP Optimization", "Citation Building", "Review Management"]
  },
  {
    title: "Google Ads & PPC",
    description: "Get leads from day one with expertly managed campaigns. Through our Spectrum partnership, qualified clients pay zero management fees.",
    price: "Custom pricing",
    href: "/services/ppc/",
    image: "/assets/images/team/marketing-team-meeting.jpg",
    features: ["$0 Management Fees*", "Google & Bing Ads", "Landing Page Design", "Call Tracking"]
  },
  {
    title: "Custom Web Design",
    description: "Lightning-fast Astro or WordPress websites custom-built to convert visitors into booked jobs. No templates. No page builders.",
    price: "Starting at $250/mo",
    href: "/services/web-design/",
    image: "/assets/images/team/office-workspace.jpg",
    features: ["Mobile-First Design", "SEO Optimized", "Conversion Focused", "CMS Included"]
  },
  {
    title: "TV & Streaming Ads",
    description: "Our exclusive Spectrum partnership puts your business on TV and streaming platforms with free professional videography for FL clients.",
    price: "Custom pricing",
    href: "/services/tv-streaming/",
    image: "/assets/images/hero/team-collaboration.jpg",
    features: ["Free Videography (FL)", "Geo-Targeted Ads", "Cross-Channel", "Brand Building"],
    badge: "EXCLUSIVE"
  }
];

const industries = [
  { name: 'HVAC', icon: '🌡️', href: '/industries/hvac/' },
  { name: 'Plumbing', icon: '🔧', href: '/industries/plumbing/' },
  { name: 'Roofing', icon: '🏠', href: '/industries/roofing/' },
  { name: 'Electrical', icon: '⚡', href: '/industries/electrical/' },
  { name: 'Pest Control', icon: '🛡️', href: '/industries/pest-control/' },
  { name: 'Garage Doors', icon: '🚪', href: '/industries/garage-doors/' },
  { name: 'Landscaping', icon: '🌿', href: '/industries/landscaping/' },
  { name: 'Pool Services', icon: '🏊', href: '/industries/pool-services/' },
];
---

<PageLayout
  title="Digital Marketing for Home Services | Local SEO, PPC, Web Design"
  description="ServiceLinePro — Digital marketing agency for home services businesses doing $1M+. Local SEO with 90-day Top 3 guarantee, Google Ads, custom websites, and TV/streaming ads via our Spectrum partnership. Tampa HQ, national reach."
  canonicalUrl="https://servicelinepro.com/"
>

  <!-- JSON-LD Schema -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness", "ProfessionalService"],
      "name": "ServiceLinePro",
      "url": "https://servicelinepro.com",
      "logo": "https://i.ytimg.com/vi/WdE4QLMESxQ/maxresdefault.jpg",
      "description": "Digital marketing agency specializing in Local SEO, PPC, Web Design, and TV/Streaming advertising for home services businesses doing $1M+ annually.",
      "telephone": "+1-813-000-0000",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tampa",
        "addressRegion": "FL",
        "addressCountry": "US"
      },
      "areaServed": { "@type": "Country", "name": "United States" },
      "sameAs": [
        "https://www.facebook.com/servicelinepro",
        "https://www.instagram.com/servicelinepro",
        "https://www.linkedin.com/company/servicelinepro"
      ]
    })} />
  </Fragment>

  <!-- ============================================
       HERO SECTION with Lead Capture Form
       ============================================ -->
  <section class="relative overflow-hidden bg-brand-dark min-h-[90vh] flex items-center">
    <!-- Background Image -->
    <div class="absolute inset-0">
      <img 
        src="/assets/images/hero/contractor-phone.jpg" 
        alt="Contractor receiving leads"
        class="w-full h-full object-cover opacity-20"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-brand-dark/95 to-brand-dark/80"></div>
    </div>
    
    <div class="container relative z-10 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Hero Content -->
        <div>
          <!-- Trust Badge -->
          <div class="inline-flex items-center gap-2 bg-brand-gold/10 border border-brand-gold/30 rounded-full px-4 py-1.5 mb-6">
            <img src="/assets/images/partners/spectrum-logo.jpg" alt="Spectrum Reach" class="h-5 w-5 rounded-full object-cover" />
            <span class="text-brand-gold text-sm font-semibold">Exclusive Spectrum Reach Partner</span>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
            Dominate Your Local Market.<br />
            <span class="text-gradient">Grow Revenue. Build Legacy.</span>
          </h1>
          
          <p class="text-lg md:text-xl text-brand-medium-gray leading-relaxed mb-8 max-w-xl">
            The digital marketing agency built <strong class="text-white">exclusively for home services businesses</strong> doing $1M+ annually. Local SEO with a 90-day guarantee, Google Ads, custom websites, and TV advertising through our Spectrum partnership.
          </p>
          
          <!-- Trust Badges Row -->
          <div class="flex flex-wrap items-center gap-4 mb-8">
            <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-lg px-3 py-2">
              <svg class="w-5 h-5 text-brand-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-white text-sm font-medium">90-Day Guarantee</span>
            </div>
            <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-lg px-3 py-2">
              <svg class="w-5 h-5 text-brand-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-white text-sm font-medium">No Contracts</span>
            </div>
            <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-lg px-3 py-2">
              <svg class="w-5 h-5 text-brand-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-white text-sm font-medium">Tampa-Based</span>
            </div>
          </div>
          
          <!-- Mobile CTA (shown on mobile only) -->
          <div class="lg:hidden">
            <a href="/booking/" class="btn-primary text-lg w-full text-center mb-3">
              Book a Free Strategy Call
            </a>
            <a href="tel:+18130000000" class="btn-secondary text-lg w-full text-center">
              Call (813) 000-0000
            </a>
          </div>
        </div>
        
        <!-- Lead Capture Form -->
        <div class="hidden lg:block">
          <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md ml-auto">
            <div class="text-center mb-6">
              <h2 class="text-2xl font-bold text-brand-dark mb-2">Get Your Free Growth Plan</h2>
              <p class="text-brand-near-black/60 text-sm">See how we can help you dominate your market in 90 days</p>
            </div>
            
            <form id="hero-form" class="space-y-4">
              <div>
                <label for="name" class="sr-only">Your Name</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  placeholder="Your Name" 
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-brand-red focus:ring-2 focus:ring-brand-red/20 outline-none transition-all"
                />
              </div>
              <div>
                <label for="email" class="sr-only">Email Address</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  placeholder="Email Address" 
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-brand-red focus:ring-2 focus:ring-brand-red/20 outline-none transition-all"
                />
              </div>
              <div>
                <label for="phone" class="sr-only">Phone Number</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  placeholder="Phone Number" 
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-brand-red focus:ring-2 focus:ring-brand-red/20 outline-none transition-all"
                />
              </div>
              <div>
                <label for="industry" class="sr-only">Your Industry</label>
                <select 
                  id="industry" 
                  name="industry"
                  class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-brand-red focus:ring-2 focus:ring-brand-red/20 outline-none transition-all text-brand-near-black/60"
                >
                  <option value="">Select Your Industry</option>
                  <option value="hvac">HVAC</option>
                  <option value="plumbing">Plumbing</option>
                  <option value="roofing">Roofing</option>
                  <option value="electrical">Electrical</option>
                  <option value="pest-control">Pest Control</option>
                  <option value="garage-doors">Garage Doors</option>
                  <option value="landscaping">Landscaping</option>
                  <option value="other">Other Home Services</option>
                </select>
              </div>
              <div>
                <label for="service" class="sr-only">Interested In</label>
                <select 
                  id="service" 
                  name="service"
                  class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-brand-red focus:ring-2 focus:ring-brand-red/20 outline-none transition-all text-brand-near-black/60"
                >
                  <option value="">What Are You Interested In?</option>
                  <option value="seo">Local SEO & Map Pack</option>
                  <option value="ppc">Google Ads / PPC</option>
                  <option value="web">Web Design</option>
                  <option value="tv">TV & Streaming Ads</option>
                  <option value="full">Full Marketing Package</option>
                </select>
              </div>
              <button type="submit" class="btn-primary w-full text-lg py-4">
                Get My Free Strategy Call →
              </button>
            </form>
            
            <p class="text-center text-xs text-brand-near-black/50 mt-4">
              No contracts. No pressure. Just a clear growth plan.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       STATS / METRICS BAR
       ============================================ -->
  <section class="bg-brand-red py-8">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
        {stats.map((stat) => (
          <div class="text-center">
            <p class="text-3xl md:text-4xl font-extrabold text-white mb-1">{stat.value}</p>
            <p class="text-white/80 text-sm font-medium">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       PARTNER LOGOS
       ============================================ -->
  <section class="bg-white py-10 border-b border-gray-100">
    <div class="container">
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
        <div class="flex items-center gap-3">
          <img src="/assets/images/partners/spectrum-logo.jpg" alt="Spectrum Reach Partner" class="h-12 w-12 rounded-lg object-cover" />
          <div>
            <p class="text-xs text-brand-near-black/50 uppercase tracking-wider">Certified Partner</p>
            <p class="font-bold text-brand-dark">Spectrum Reach</p>
          </div>
        </div>
        <div class="h-8 w-px bg-gray-200 hidden md:block"></div>
        <div class="flex items-center gap-2 opacity-60">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
          </svg>
          <span class="font-semibold text-brand-dark">Google Partner</span>
        </div>
        <div class="h-8 w-px bg-gray-200 hidden md:block"></div>
        <div class="text-center opacity-60">
          <p class="text-2xl font-bold text-brand-dark">4.9★</p>
          <p class="text-xs text-brand-near-black/50">Client Rating</p>
        </div>
        <div class="h-8 w-px bg-gray-200 hidden md:block"></div>
        <div class="text-center opacity-60">
          <p class="text-2xl font-bold text-brand-dark">100+</p>
          <p class="text-xs text-brand-near-black/50">Home Service Clients</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       WHY SERVICELINEPRO
       ============================================ -->
  <section class="bg-brand-light-gray py-20">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <p class="text-brand-red font-semibold text-sm tracking-widest uppercase mb-3 font-[family-name:var(--font-ui)]">Why ServiceLinePro</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Built for Home Services. Backed by Results.</h2>
        <p class="text-brand-near-black/60 text-lg">
          We don't work with restaurants, dentists, or e-commerce stores. Every strategy, every campaign, and every dollar is focused on helping home services businesses grow.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 text-center hover:shadow-lg transition-shadow">
          <div class="w-20 h-20 bg-gradient-to-br from-brand-red to-brand-coral rounded-2xl flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">90-Day Top 3 Guarantee</h3>
          <p class="text-brand-near-black/60 text-sm leading-relaxed">
            We guarantee your primary keyword ranks in the top 3 of Google's Map Pack within 90 days — or we work for free until it does. Real accountability.
          </p>
        </div>
        
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 text-center hover:shadow-lg transition-shadow">
          <div class="w-20 h-20 bg-gradient-to-br from-brand-gold to-yellow-500 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Exclusive Spectrum Partnership</h3>
          <p class="text-brand-near-black/60 text-sm leading-relaxed">
            Put your business on TV and streaming with our direct Spectrum partnership. Florida clients get <strong>free professional videography</strong>.
          </p>
        </div>
        
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 text-center hover:shadow-lg transition-shadow">
          <div class="w-20 h-20 bg-gradient-to-br from-brand-dark to-gray-700 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Home Services Specialists</h3>
          <p class="text-brand-near-black/60 text-sm leading-relaxed">
            HVAC, plumbing, roofing, electrical — we know your customer, your competition, and your margins. Strategies built for $1M+ businesses.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       SERVICES WITH IMAGE CARDS
       ============================================ -->
  <section class="section-dark py-20">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <p class="text-brand-gold font-semibold text-sm tracking-widest uppercase mb-3 font-[family-name:var(--font-ui)]">Our Services</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Four Pillars of Growth</h2>
        <p class="text-brand-medium-gray text-lg">
          Every service works independently or as part of a complete growth engine. Most clients stack two or more for maximum market penetration.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map((service) => (
          <a href={service.href} class="group relative overflow-hidden rounded-2xl bg-white/5 border border-white/10 hover:border-white/20 transition-all hover:shadow-2xl">
            {service.badge && (
              <div class="absolute top-4 right-4 z-10 bg-brand-gold text-brand-dark text-xs font-bold px-3 py-1 rounded-full">
                {service.badge}
              </div>
            )}
            <div class="flex flex-col md:flex-row">
              <!-- Image -->
              <div class="md:w-2/5 h-48 md:h-auto relative overflow-hidden">
                <img 
                  src={service.image} 
                  alt={service.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-r from-transparent to-brand-dark/50 md:block hidden"></div>
              </div>
              <!-- Content -->
              <div class="md:w-3/5 p-6 md:p-8">
                <h3 class="text-xl md:text-2xl font-bold text-white mb-3 group-hover:text-brand-gold transition-colors">
                  {service.title}
                </h3>
                <p class="text-brand-medium-gray text-sm leading-relaxed mb-4">
                  {service.description}
                </p>
                <div class="flex flex-wrap gap-2 mb-4">
                  {service.features.map((feature) => (
                    <span class="text-xs bg-white/10 text-white/80 px-2 py-1 rounded">{feature}</span>
                  ))}
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-brand-gold font-semibold text-sm">{service.price}</span>
                  <span class="text-brand-red font-semibold text-sm group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                    Learn More <span>&rarr;</span>
                  </span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       CASE STUDIES PREVIEW
       ============================================ -->
  <section class="bg-white py-20">
    <div class="container">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
        <div>
          <p class="text-brand-red font-semibold text-sm tracking-widest uppercase mb-3 font-[family-name:var(--font-ui)]">Proven Results</p>
