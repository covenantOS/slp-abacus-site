---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="Industries" description="Digital marketing solutions for HVAC, Plumbing, Roofing, Electrical, Construction, and more.">
  <section class="section-dark py-20">
    <div class="container">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Industries We Serve</h1>
      <p class="text-brand-medium-gray text-lg max-w-2xl">
        Specialized marketing for every home services vertical.
      </p>
    </div>
  </section>
  <section class="py-16">
    <div class="container">
      <p class="text-lg text-brand-near-black">Industry pages coming soon.</p>
    </div>
  </section>
</PageLayout>
