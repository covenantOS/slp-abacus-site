---
import PageLayout from '../../layouts/PageLayout.astro';
import CTASection from '../../components/CTASection.astro';
import TrustSignals from '../../components/TrustSignals.astro';
import FAQ from '../../components/FAQ.astro';

const industry = {
  name: 'Electrical',
  icon: '⚡',
  headline: 'Electrical Marketing That Powers Growth',
  subheadline: 'Book more panel upgrades, EV charger installs, and emergency calls with marketing that generates real ROI.',
  challenges: [
    'Trust is critical — customers worry about safety',
    'Competing with handymen who undercut on price',
    'Capturing high-value commercial contracts',
    'Marketing emerging services like EV charging'
  ],
  services: [
    { name: 'Panel Upgrades', icon: '🔌' },
    { name: 'EV Chargers', icon: '🚗' },
    { name: 'Emergency Service', icon: '🚨' },
    { name: 'Rewiring', icon: '🏠' },
    { name: 'Lighting', icon: '💡' },
    { name: 'Commercial', icon: '🏢' }
  ]
};

const faqs = [
  { question: 'How do you market electrical services vs general contractors?', answer: 'We emphasize your licensing, insurance, and expertise. Our content strategy positions you as the safe, professional choice — not just another handyman.' },
  { question: 'Can you help me rank for EV charger installation?', answer: 'Absolutely! EV charger searches are growing 40%+ year over year. We create targeted campaigns for this high-ticket service to capture early market share.' },
  { question: 'What about commercial electrical leads?', answer: 'We create separate B2B strategies including LinkedIn campaigns and commercial-focused landing pages to capture property managers and business owners.' },
  { question: 'How much does electrical marketing cost?', answer: 'Local SEO starts at $2,500/mo. We offer custom packages based on your service area and goals. Book a free strategy call for exact pricing.' }
];
---

<PageLayout
  title="Electrical Marketing Services | Grow Your Electrical Business | ServiceLinePro"
  description="Electrical contractor marketing that generates real leads. Local SEO, Google Ads, and TV advertising for electricians. 90-day guarantee. Free strategy call."
  canonicalUrl="https://servicelinepro.com/industries/electrical/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Electrical Marketing Services",
      "provider": { "@type": "LocalBusiness", "name": "ServiceLinePro" },
      "areaServed": "United States"
    })} />
  </Fragment>

  <nav class="bg-white border-b border-gray-200 py-3">
    <div class="container mx-auto px-4">
      <ol class="flex items-center gap-2 text-sm text-gray-500">
        <li><a href="/" class="hover:text-brand-red">Home</a></li>
        <li>/</li>
        <li><a href="/industries/" class="hover:text-brand-red">Industries</a></li>
        <li>/</li>
        <li class="text-brand-red font-medium">{industry.name}</li>
      </ol>
    </div>
  </nav>

  <section class="bg-gradient-to-br from-white via-brand-light-gray to-white py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="text-6xl mb-6">{industry.icon}</div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-brand-dark mb-6">{industry.headline}</h1>
        <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">{industry.subheadline}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/booking/" class="btn-primary">Get Your Free Growth Plan →</a>
          <a href="tel:8135213199" class="btn-secondary !border-brand-dark !text-brand-dark hover:!bg-brand-dark hover:!text-white">(813) 521-3199</a>
        </div>
      </div>
    </div>
  </section>

  <TrustSignals />

  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-dark text-center mb-12">We Understand {industry.name} Marketing Challenges</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {industry.challenges.map((challenge) => (
            <div class="flex gap-4 p-6 bg-brand-light-gray rounded-xl">
              <div class="w-8 h-8 bg-brand-red/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              </div>
              <p class="text-brand-dark font-medium">{challenge}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-brand-light-gray">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-dark text-center mb-12">{industry.name} Services We Help You Market</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {industry.services.map((service) => (
            <div class="bg-white rounded-xl p-6 text-center border border-gray-200 hover:border-brand-red hover:shadow-lg transition-all">
              <span class="text-3xl mb-3 block">{service.icon}</span>
              <p class="font-heading font-bold text-brand-dark">{service.name}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-dark text-center mb-12">How We Help {industry.name} Companies Grow</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <a href="/services/local-seo/" class="block bg-white rounded-2xl p-6 border-2 border-gray-200 hover:border-brand-red transition-all group">
            <div class="text-4xl mb-4">📍</div>
            <h3 class="font-heading font-bold text-brand-dark mb-2 group-hover:text-brand-red">Local SEO</h3>
            <p class="text-gray-600 text-sm">Rank #1 in Google Maps for "{industry.name} near me" searches.</p>
          </a>
          <a href="/services/ppc/" class="block bg-white rounded-2xl p-6 border-2 border-gray-200 hover:border-brand-red transition-all group">
            <div class="text-4xl mb-4">📈</div>
            <h3 class="font-heading font-bold text-brand-dark mb-2 group-hover:text-brand-red">Google Ads</h3>
            <p class="text-gray-600 text-sm">Get leads from day one with our no-fee PPC management.</p>
          </a>
          <a href="/services/web-design/" class="block bg-white rounded-2xl p-6 border-2 border-gray-200 hover:border-brand-red transition-all group">
            <div class="text-4xl mb-4">💻</div>
            <h3 class="font-heading font-bold text-brand-dark mb-2 group-hover:text-brand-red">Web Design</h3>
            <p class="text-gray-600 text-sm">Conversion-focused websites that turn visitors into customers.</p>
          </a>
          <a href="/services/tv-streaming/" class="block bg-white rounded-2xl p-6 border-2 border-gray-200 hover:border-brand-red transition-all group">
            <div class="text-4xl mb-4">📺</div>
            <h3 class="font-heading font-bold text-brand-dark mb-2 group-hover:text-brand-red">TV & Streaming</h3>
            <p class="text-gray-600 text-sm">Build brand awareness with targeted TV ads via Spectrum.</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-brand-light-gray">
    <div class="container mx-auto px-4"><FAQ items={faqs} headline={`${industry.name} Marketing FAQs`} /></div>
  </section>

  <CTASection headline={`Ready to Dominate ${industry.name} Marketing?`} subheadline="Get a free growth plan customized for your business." buttonText="Book Your Free Strategy Call →" buttonHref="/booking/" secondaryText="Call (813) 521-3199" secondaryHref="tel:8135213199" />
</PageLayout>