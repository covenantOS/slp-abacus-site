---
import PageLayout from '../../layouts/PageLayout.astro';
import CTASection from '../../components/CTASection.astro';
import FAQ from '../../components/FAQ.astro';
import TrustSignals from '../../components/TrustSignals.astro';

const faqs = [
  {
    question: 'What is Spectrum Reach and why does it matter?',
    answer: 'Spectrum Reach is the advertising division of Charter Communications — one of the largest cable and internet providers in the United States. They provide first-party data on 30+ million households across 36 states, TAG-certified ad delivery, and enterprise-level buying power. Our partnership with Spectrum means your TV and streaming ads are powered by the same infrastructure Fortune 500 brands use — at a fraction of the cost.',
  },
  {
    question: 'Do you really provide free videography for Florida clients?',
    answer: 'Yes. If your business is located in Florida, <strong>Spectrum provides professional video production at no cost</strong> — including concept development, filming, editing, and final delivery. This includes TV-quality commercials that you own and can use across all platforms. For clients outside Florida, we coordinate production at competitive rates through our network of Spectrum-approved production partners.',
  },
  {
    question: 'What streaming platforms will my ads appear on?',
    answer: 'Your ads can appear across premium streaming inventory including networks available through Spectrum\'s connected TV platform. This includes popular ad-supported streaming services, live TV streaming, on-demand content, and premium cable networks. Spectrum\'s reach covers both traditional cable viewers and cord-cutters who watch through streaming apps and smart TVs.',
  },
  {
    question: 'How is this different from buying YouTube ads?',
    answer: 'YouTube ads compete with millions of advertisers in a self-serve auction. Spectrum TV and streaming ads appear in premium, curated environments — during actual TV programming and professional streaming content. The viewer experience is closer to a Super Bowl commercial than a skippable pre-roll. Higher attention, higher recall, higher trust.',
  },
  {
    question: 'Can I target specific neighborhoods or zip codes?',
    answer: 'Absolutely. Spectrum\'s targeting capabilities go far beyond basic demographics. You can target by zip code, neighborhood, household income, homeownership status, viewing behavior, and even recent purchase intent signals. For home services businesses, this means your commercial reaches homeowners in your exact service area — not renters three cities away.',
  },
  {
    question: 'What kind of results should I expect?',
    answer: 'TV and streaming advertising builds brand awareness and trust that compounds over time. Clients typically see increased branded search volume (people Googling your company name), higher conversion rates on existing PPC and SEO campaigns, and stronger close rates from inbound leads. The synergy between TV exposure and digital campaigns is where the real ROI multiplier lives.',
  },
  {
    question: 'How does TV/streaming work with my digital campaigns?',
    answer: 'TV and streaming advertising creates a powerful "halo effect" for your digital campaigns. When a homeowner sees your commercial on TV and then searches for your service on Google, they\'re significantly more likely to click your ad and convert. We coordinate TV flight schedules with your PPC and SEO strategy so all channels amplify each other.',
  },
];
---

<PageLayout
  title="TV & Streaming Advertising for Home Services | Spectrum Partnership"
  description="ServiceLinePro's Spectrum Reach partnership brings TV and streaming ads to home services businesses. Free videography for Florida clients. Target 30M+ households across 36 states."
  canonicalUrl="https://servicelinepro.com/services/tv-streaming/"
>

  <!-- JSON-LD Schema -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "TV & Streaming Advertising for Home Services",
      "provider": {
        "@type": "Organization",
        "name": "ServiceLinePro",
        "url": "https://servicelinepro.com"
      },
      "description": "TV and streaming advertising through Spectrum Reach partnership. Free professional video production for Florida clients. Reach 30M+ households across 36 states.",
      "areaServed": { "@type": "Country", "name": "United States" }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://servicelinepro.com/" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://servicelinepro.com/services/" },
        { "@type": "ListItem", "position": 3, "name": "TV & Streaming", "item": "https://servicelinepro.com/services/tv-streaming/" }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": { "@type": "Answer", "text": f.answer.replace(/<[^>]*>/g, '') }
      }))
    })} />
  </Fragment>

  <!-- Breadcrumb -->
  <nav class="bg-brand-dark/95 border-b border-white/10 py-3">
    <div class="container mx-auto px-4">
      <ol class="flex items-center gap-2 text-sm text-gray-400">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li class="text-gray-600">/</li>
        <li><a href="/services/" class="hover:text-white transition-colors">Services</a></li>
        <li class="text-gray-600">/</li>
        <li class="text-brand-red font-medium">TV & Streaming</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="section-dark py-20 md:py-28">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block bg-brand-gold/15 text-brand-gold text-sm font-semibold tracking-wider uppercase px-4 py-2 rounded-full mb-6">Spectrum Reach Certified Partner</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white mb-6 leading-tight">
          Put Your Business on<br />
          <span class="text-brand-red">TV and Streaming</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-3xl mx-auto leading-relaxed">
          Our Spectrum Reach partnership gives your home services company access to TV-quality advertising, 30+ million households of first-party data, and — for Florida clients — free professional videography and film production.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
          <a href="/booking/" class="btn-primary text-lg px-8 py-4">Book a Strategy Call →</a>
          <a href="#florida" class="btn-secondary text-lg px-8 py-4">Free Videography Details</a>
        </div>
        <div class="flex flex-wrap justify-center gap-6 text-sm text-gray-400">
          <span class="flex items-center gap-2">📺 TV + Streaming Placements</span>
          <span class="flex items-center gap-2">🎬 Free FL Videography</span>
          <span class="flex items-center gap-2">📡 36 States Covered</span>
          <span class="flex items-center gap-2">🏠 30M+ Households</span>
        </div>
      </div>
    </div>
  </section>

  <TrustSignals />

  <!-- Game-Changer Section -->
  <section class="section-light py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-dark text-center mb-6">
          The Spectrum Partnership Changes Everything
        </h2>
        <p class="text-gray-600 text-center text-lg mb-12 max-w-3xl mx-auto">
          TV advertising used to be reserved for companies with six-figure budgets and national agencies. Our Spectrum Reach partnership makes it accessible and affordable for home services businesses doing $1M+ annually.
        </p>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <div class="bg-red-50 rounded-2xl p-8 border border-red-100">
            <h3 class="text-xl font-heading font-bold text-brand-dark mb-4">❌ Traditional TV Advertising</h3>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start gap-2"><span class="text-brand-red font-bold mt-0.5">•</span> $50,000+ minimum budgets to get started</li>
              <li class="flex items-start gap-2"><span class="text-brand-red font-bold mt-0.5">•</span> Expensive production costs ($10K–$50K per commercial)</li>
              <li class="flex items-start gap-2"><span class="text-brand-red font-bold mt-0.5">•</span> Broad, untargeted reach — pay for everyone, including renters</li>
              <li class="flex items-start gap-2"><span class="text-brand-red font-bold mt-0.5">•</span> No performance tracking or attribution</li>
              <li class="flex items-start gap-2"><span class="text-brand-red font-bold mt-0.5">•</span> Long lead times and rigid scheduling</li>
              <li class="flex items-start gap-2"><span class="text-brand-red font-bold mt-0.5">•</span> No integration with digital campaigns</li>
            </ul>
          </div>
          <div class="bg-green-50 rounded-2xl p-8 border border-green-100">
            <h3 class="text-xl font-heading font-bold text-brand-dark mb-4">✅ Spectrum-Powered TV & Streaming</h3>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start gap-2"><span class="text-green-600 font-bold mt-0.5">•</span> Accessible budgets for $1M+ home services companies</li>
              <li class="flex items-start gap-2"><span class="text-green-600 font-bold mt-0.5">•</span> Free professional videography for Florida clients</li>
              <li class="flex items-start gap-2"><span class="text-green-600 font-bold mt-0.5">•</span> Hyper-targeted by zip code, income, and homeownership</li>
              <li class="flex items-start gap-2"><span class="text-green-600 font-bold mt-0.5">•</span> Cross-channel attribution with digital campaigns</li>
              <li class="flex items-start gap-2"><span class="text-green-600 font-bold mt-0.5">•</span> Flexible flight schedules aligned to your busy seasons</li>
              <li class="flex items-start gap-2"><span class="text-green-600 font-bold mt-0.5">•</span> Coordinated with PPC and SEO for maximum impact</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why TV Still Matters -->
  <section class="section-dark py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-white text-center mb-4">
          Why TV & Streaming Still Dominates for Home Services
        </h2>
        <p class="text-gray-400 text-center text-lg mb-12 max-w-2xl mx-auto">
          Digital ads generate clicks. TV and streaming generate trust. When a homeowner sees your company on their television, you are no longer just another search result — you are a recognized brand.
        </p>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10 text-center">
            <div class="text-4xl font-heading font-bold text-brand-red mb-2">80%</div>
            <p class="text-gray-300 text-sm">of consumers say TV ads increase their trust in a brand</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10 text-center">
            <div class="text-4xl font-heading font-bold text-brand-gold mb-2">3x</div>
            <p class="text-gray-300 text-sm">higher brand recall vs. digital display advertising alone</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10 text-center">
            <div class="text-4xl font-heading font-bold text-brand-red mb-2">60%</div>
            <p class="text-gray-300 text-sm">of viewers research a brand online after seeing a TV ad</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10 text-center">
            <div class="text-4xl font-heading font-bold text-brand-gold mb-2">30M+</div>
            <p class="text-gray-300 text-sm">households reachable through Spectrum's first-party data</p>
          </div>
        </div>

        <div class="bg-white/5 rounded-2xl p-8 border border-white/10">
          <h3 class="text-xl font-heading font-bold text-white mb-4">The Digital + TV Multiplier Effect</h3>
          <p class="text-gray-400 mb-4">
            When a homeowner sees your company on TV and then encounters your Google ad, your SEO listing, or your social media — they already trust you. This is the multiplier effect that separates companies doing $1M from companies doing $5M. TV creates the top-of-mind awareness. Digital captures the intent. Together, they are unstoppable.
          </p>
          <p class="text-gray-400">
            Our campaigns are deliberately coordinated. TV flight schedules align with PPC budget increases. Streaming ads target the same demographics as your search campaigns. The result is a unified presence that makes your company feel omnipresent in your market — and that perception drives higher conversion rates across every channel.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Florida Free Videography -->
  <section id="florida" class="py-16 md:py-20 bg-gradient-to-br from-brand-red/5 via-white to-brand-gold/5">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <span class="inline-block bg-brand-red/10 text-brand-red text-sm font-semibold tracking-wider uppercase px-4 py-2 rounded-full mb-4">Florida Exclusive</span>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-dark mb-4">
            Free Professional Videography & Film Production
          </h2>
          <p class="text-gray-600 text-lg max-w-2xl mx-auto">
            For Florida-based home services clients, Spectrum provides complimentary professional video production — the single most expensive barrier to TV advertising, eliminated entirely.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-12">
          <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-md text-center">
            <div class="text-4xl mb-4">🎥</div>
            <h3 class="text-lg font-heading font-bold text-brand-dark mb-3">Professional Filming</h3>
            <p class="text-gray-600 text-sm">Spectrum's production team films on-location at your business, job sites, or office. Professional cameras, lighting, and sound. Your team, your trucks, your brand — captured in broadcast-quality video.</p>
          </div>
          <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-md text-center">
            <div class="text-4xl mb-4">✂️</div>
            <h3 class="text-lg font-heading font-bold text-brand-dark mb-3">Expert Editing & Post</h3>
            <p class="text-gray-600 text-sm">From raw footage to polished commercials — Spectrum's post-production team handles editing, graphics, music licensing, voiceover, and final delivery. Multiple versions optimized for TV, streaming, and social media.</p>
          </div>
          <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-md text-center">
            <div class="text-4xl mb-4">🏆</div>
            <h3 class="text-lg font-heading font-bold text-brand-dark mb-3">You Own Everything</h3>
            <p class="text-gray-600 text-sm">Every video asset produced belongs to you. Use your commercials on YouTube, social media, your website, sales presentations — anywhere. This is not a rental. These are your assets, built for your brand, at zero production cost.</p>
          </div>
        </div>

        <div class="bg-brand-dark rounded-2xl p-8 text-center">
          <h3 class="text-xl font-heading font-bold text-white mb-4">What This Would Normally Cost</h3>
          <div class="grid grid-cols-3 gap-4 mb-6">
            <div>
              <p class="text-gray-400 text-sm mb-1">Concept & Scripting</p>
              <p class="text-brand-red text-2xl font-heading font-bold line-through">$2,000+</p>
            </div>
            <div>
              <p class="text-gray-400 text-sm mb-1">Professional Filming</p>
              <p class="text-brand-red text-2xl font-heading font-bold line-through">$5,000+</p>
            </div>
            <div>
              <p class="text-gray-400 text-sm mb-1">Editing & Post</p>
              <p class="text-brand-red text-2xl font-heading font-bold line-through">$3,000+</p>
            </div>
          </div>
          <div class="bg-green-500/10 rounded-xl p-4 border border-green-500/20 inline-block">
            <p class="text-green-400 font-heading font-bold text-2xl">$0 for Florida Clients</p>
            <p class="text-gray-400 text-sm mt-1">$10,000+ in production value — included free through our Spectrum partnership</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Deliver -->
  <section class="section-dark py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-white text-center mb-12">
          What Your TV & Streaming Campaign Includes
        </h2>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white/5 rounded-xl p-6 border border-white/10">
            <div class="text-3xl mb-3">📺</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">Traditional Cable Placements</h3>
            <p class="text-gray-400 text-sm">Your commercial airs on popular cable networks within your designated market area. Spectrum's local insertion technology ensures your ad plays specifically for viewers in your service area — not the entire state.</p>
          </div>
          <div class="bg-white/5 rounded-xl p-6 border border-white/10">
            <div class="text-3xl mb-3">🖥️</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">Connected TV & Streaming</h3>
            <p class="text-gray-400 text-sm">Reach cord-cutters and streaming-first households through Spectrum's connected TV inventory. Your ads appear in premium, non-skippable placements during professional content — not YouTube pre-rolls.</p>
          </div>
          <div class="bg-white/5 rounded-xl p-6 border border-white/10">
            <div class="text-3xl mb-3">🎯</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">Audience Targeting</h3>
            <p class="text-gray-400 text-sm">Target by zip code, household income, home ownership, age, viewing habits, and purchase intent. Reach the homeowners most likely to need your services — right when they are watching.</p>
          </div>
          <div class="bg-white/5 rounded-xl p-6 border border-white/10">
            <div class="text-3xl mb-3">📈</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">Cross-Channel Attribution</h3>
            <p class="text-gray-400 text-sm">We track the impact of your TV campaigns through branded search lift, direct traffic increases, and conversion rate changes across your digital campaigns. See the full picture, not just impressions.</p>
          </div>
          <div class="bg-white/5 rounded-xl p-6 border border-white/10">
            <div class="text-3xl mb-3">📅</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">Seasonal Flight Planning</h3>
            <p class="text-gray-400 text-sm">We schedule your TV and streaming campaigns around your peak seasons. HVAC companies ramp up before summer. Roofers push before storm season. Every dollar is timed for maximum impact.</p>
          </div>
          <div class="bg-white/5 rounded-xl p-6 border border-white/10">
            <div class="text-3xl mb-3">🔗</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">Digital Campaign Integration</h3>
            <p class="text-gray-400 text-sm">Your TV schedule is coordinated with PPC budget increases and SEO content pushes. When your commercial is running, your digital campaigns are amplified. When it pauses, digital picks up the slack.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Unique Advantage -->
  <section class="section-light py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-dark text-center mb-6">
          A Market Advantage No Other Agency Can Offer
        </h2>
        <p class="text-gray-600 text-center text-lg mb-8 max-w-3xl mx-auto">
          There are thousands of agencies that run Google Ads. Hundreds that do SEO. But virtually none that can put your home services company on TV with free professional videography, first-party data targeting, and full digital integration.
        </p>
        <div class="bg-brand-dark rounded-2xl p-8 md:p-12">
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
              <h3 class="text-2xl font-heading font-bold text-white mb-4">Why This Matters for Your Business</h3>
              <p class="text-gray-300 mb-4">
                Your competitors are fighting over the same Google Ads keywords, the same Map Pack positions, the same Facebook audiences. TV and streaming advertising opens an entirely different channel — one where you build brand authority that makes every other marketing dollar work harder.
              </p>
              <p class="text-gray-300 mb-4">
                When a homeowner has seen your commercial three times this week and then searches "AC repair near me" — they are clicking your listing. They are calling your number. They are choosing the company they recognize over the company they have never heard of.
              </p>
              <p class="text-gray-300">
                That is the power of TV. And with ServiceLinePro's Spectrum partnership, it is finally accessible to home services businesses that are serious about growth.
              </p>
            </div>
            <div class="space-y-4">
              <div class="bg-white/5 rounded-xl p-4 border border-white/10">
                <p class="text-brand-gold font-heading font-bold text-lg">🏠 For Florida Clients</p>
                <p class="text-gray-400 text-sm mt-1">Free videography, free production, free editing. Your only cost is the media buy itself.</p>
              </div>
              <div class="bg-white/5 rounded-xl p-4 border border-white/10">
                <p class="text-brand-gold font-heading font-bold text-lg">🌎 For National Clients</p>
                <p class="text-gray-400 text-sm mt-1">Spectrum covers 36 states. Wherever you operate, we can deploy TV and streaming campaigns.</p>
              </div>
              <div class="bg-white/5 rounded-xl p-4 border border-white/10">
                <p class="text-brand-gold font-heading font-bold text-lg">📊 For Multi-Channel Clients</p>
                <p class="text-gray-400 text-sm mt-1">Already running SEO and PPC with us? TV amplifies everything. Expect higher CTRs, lower CPLs, and stronger brand search.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Internal Links -->
  <section class="section-light py-16 md:py-20 border-t border-gray-200">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-heading font-bold text-brand-dark mb-4">Build a Complete Marketing System</h2>
        <p class="text-gray-600 text-lg mb-8">TV builds the brand. Digital captures the demand. Together, they dominate your market.</p>
        <div class="grid md:grid-cols-3 gap-6">
          <a href="/services/local-seo/" class="block bg-white rounded-xl p-6 border border-gray-200 hover:border-brand-red hover:shadow-lg transition-all">
            <div class="text-3xl mb-3">📍</div>
            <h3 class="font-heading font-bold text-brand-dark mb-2">Local SEO</h3>
            <p class="text-gray-600 text-sm">Own the Map Pack so TV-driven searches find you first.</p>
          </a>
          <a href="/services/ppc/" class="block bg-white rounded-xl p-6 border border-gray-200 hover:border-brand-red hover:shadow-lg transition-all">
            <div class="text-3xl mb-3">🎯</div>
            <h3 class="font-heading font-bold text-brand-dark mb-2">PPC & Google Ads</h3>
            <p class="text-gray-600 text-sm">Capture intent-driven searches amplified by TV awareness.</p>
          </a>
          <a href="/services/web-design/" class="block bg-white rounded-xl p-6 border border-gray-200 hover:border-brand-red hover:shadow-lg transition-all">
            <div class="text-3xl mb-3">💻</div>
            <h3 class="font-heading font-bold text-brand-dark mb-2">Web Design</h3>
            <p class="text-gray-600 text-sm">Convert TV and digital traffic on a site built to book jobs.</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section-dark py-16 md:py-20">
    <div class="container mx-auto px-4">
      <FAQ headline="TV & Streaming Advertising — Frequently Asked Questions" items={faqs} />
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    headline="Ready to Put Your Company on TV?"
    subheadline="Book a free strategy call to explore how our Spectrum partnership can bring TV and streaming advertising to your home services business — with free videography for Florida clients."
    buttonText="Book Your Free Strategy Call →"
    buttonHref="/booking/"
    secondaryText="Call (813) 521-3199"
    secondaryHref="tel:8135213199"
  />

</PageLayout>
