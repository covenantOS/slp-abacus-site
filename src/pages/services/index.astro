---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="Services" description="ServiceLinePro offers Local SEO, PPC/Google Ads, Web Design, and TV/Streaming advertising for home services businesses.">
  <section class="section-dark py-20">
    <div class="container">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Our Services</h1>
      <p class="text-brand-medium-gray text-lg max-w-3xl">
        Four pillars of growth designed specifically for home services companies doing $1M+ annually.
      </p>
    </div>
  </section>
  <section class="py-16">
    <div class="container">
      <p class="text-lg text-brand-near-black">Service detail pages coming soon.</p>
    </div>
  </section>
</PageLayout>
