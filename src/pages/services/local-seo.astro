<!-- Interactive Calculator Script -->
<script is:inline>
  (function() {
    // Pricing data from the product plan
    const pricing = {
      foundation: { small: 1500, big: 2000 },
      accelerator: { none: 0, neighborhood: 1000, city: 2000 },
      linkBuilding: 1500,
      setup: { standard: 1500, accelerated: 2500, '12month': 0 }
    };

    // State
    let state = {
      market: 'small',
      accel: 'none',
      linkBuilding: false,
      setup: 'standard'
    };

    // Elements
    const summaryFoundation = document.getElementById('summary-foundation');
    const summaryAccelRow = document.getElementById('summary-accel-row');
    const summaryAccelLabel = document.getElementById('summary-accel-label');
    const summaryAccel = document.getElementById('summary-accel');
    const summaryLinksRow = document.getElementById('summary-links-row');
    const summaryMonthly = document.getElementById('summary-monthly');
    const summarySetup = document.getElementById('summary-setup');
    const summarySetupNote = document.getElementById('summary-setup-note');
    const summaryGuarantee = document.getElementById('summary-guarantee');

    function updateSummary() {
      const foundationPrice = pricing.foundation[state.market];
      const accelPrice = pricing.accelerator[state.accel];
      const linkPrice = state.linkBuilding ? pricing.linkBuilding : 0;
      const setupPrice = pricing.setup[state.setup];
      const monthly = foundationPrice + accelPrice + linkPrice;

      summaryFoundation.textContent = '$' + foundationPrice.toLocaleString() + '/mo';

      if (accelPrice > 0) {
        summaryAccelRow.style.display = 'flex';
        const accelNames = { neighborhood: 'Neighborhood Accel.', city: 'City Accelerator' };
        summaryAccelLabel.textContent = accelNames[state.accel] || 'Accelerator';
        summaryAccel.textContent = '+$' + accelPrice.toLocaleString() + '/mo';
      } else {
        summaryAccelRow.style.display = 'none';
      }

      if (state.linkBuilding) {
        summaryLinksRow.style.display = 'flex';
      } else {
        summaryLinksRow.style.display = 'none';
      }

      summaryMonthly.textContent = '$' + monthly.toLocaleString();

      if (state.setup === '12month') {
        summarySetup.textContent = '$0';
        summarySetup.classList.add('text-green-400');
        summarySetupNote.textContent = '12-month commitment — setup waived!';
      } else {
        summarySetup.textContent = '$' + setupPrice.toLocaleString();
        summarySetup.classList.remove('text-green-400');
        const setupNames = { standard: 'Standard Launch', accelerated: 'Accelerated Launch (3mo in 30 days)' };
        summarySetupNote.textContent = setupNames[state.setup];
      }

      // Show guarantee if accel is selected
      if (state.accel !== 'none') {
        summaryGuarantee.style.display = 'block';
      } else {
        summaryGuarantee.style.display = 'none';
      }
    }

    // Market buttons
    document.querySelectorAll('.market-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        state.market = this.dataset.market;
        document.querySelectorAll('.market-btn').forEach(function(b) {
          b.classList.remove('active');
          b.classList.replace('border-brand-red', 'border-gray-200');
          if (!b.classList.contains('border-gray-200') && !b.classList.contains('border-brand-red')) {
            b.classList.add('border-gray-200');
          }
        });
        this.classList.add('active');
        this.classList.remove('border-gray-200');
        this.classList.add('border-brand-red');
        // Fix other buttons
        document.querySelectorAll('.market-btn:not(.active)').forEach(function(b) {
          b.classList.remove('border-brand-red');
          b.classList.add('border-gray-200');
        });
        updateSummary();
      });
    });

    // Accelerator buttons
    document.querySelectorAll('.accel-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        state.accel = this.dataset.accel;
        document.querySelectorAll('.accel-btn').forEach(function(b) {
          b.classList.remove('active');
          b.classList.remove('border-brand-red');
          b.classList.add('border-gray-200');
        });
        this.classList.add('active');
        this.classList.remove('border-gray-200');
        this.classList.add('border-brand-red');
        updateSummary();
      });
    });

    // Setup buttons
    document.querySelectorAll('.setup-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        state.setup = this.dataset.setup;
        document.querySelectorAll('.setup-btn').forEach(function(b) {
          b.classList.remove('active');
          b.classList.remove('border-brand-red');
          b.classList.add('border-gray-200');
        });
        this.classList.add('active');
        this.classList.remove('border-gray-200');
        this.classList.add('border-brand-red');
        updateSummary();
      });
    });

    // Link building checkbox
    var linkCheckbox = document.getElementById('link-building');
    if (linkCheckbox) {
      linkCheckbox.addEventListener('change', function() {
        state.linkBuilding = this.checked;
        var label = this.closest('.addon-label');
        if (this.checked) {
          label.classList.remove('border-gray-200');
          label.classList.add('border-brand-red');
        } else {
          label.classList.remove('border-brand-red');
          label.classList.add('border-gray-200');
        }
        updateSummary();
      });
    }

    // Initialize
    updateSummary();
  })();
</script>
