---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="About" description="Learn about ServiceLinePro — Tampa-based digital marketing agency specializing in home services businesses.">
  <section class="section-dark py-20">
    <div class="container">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">About ServiceLinePro</h1>
      <p class="text-brand-medium-gray text-lg max-w-3xl">
        We're a Tampa-based digital marketing agency laser-focused on helping home services
        businesses dominate their local markets. Founded by William Hamilton, our team combines
        deep industry expertise with cutting-edge digital strategies.
      </p>
    </div>
  </section>
  <section class="py-16">
    <div class="container">
      <p class="text-lg text-brand-near-black leading-relaxed">
        Content coming soon. This page will feature our company story, team members, values, and timeline.
      </p>
    </div>
  </section>
</PageLayout>
