---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/CTASection.astro';
import TrustSignals from '../components/TrustSignals.astro';

const teamMembers = [
  {
    name: 'Will Hamilton',
    title: 'CEO & Founder',
    photo: '/assets/images/william-hamilton.webp',
    hasPhoto: true,
    bio: 'Will founded ServiceLinePro in 2020 after identifying a massive gap in the home services marketing industry — companies were spending thousands on agencies with zero clarity on ROI. Starting his career at 16 in high-stakes production (film, editing, weddings, music), Will built a performance-first model that ties every marketing dollar directly to leads, jobs, and revenue. Today he leads the company\'s strategic vision, Spectrum Reach partnership, and client relationships across the nation.',
    linkedin: 'https://www.linkedin.com/in/williamhamilton16',
  },
  {
    name: 'Victoria Hamilton',
    title: 'Director of Operations',
    photo: '/assets/images/victoria-hamilton.webp',
    hasPhoto: true,
    bio: 'Victoria oversees the day-to-day operations of ServiceLinePro, ensuring every client campaign runs smoothly from onboarding through delivery. She manages workflows, team coordination, quality assurance, and client communications. Her operational discipline keeps the agency running efficiently as the team scales, and her attention to detail ensures nothing slips through the cracks.',
    linkedin: null,
  },
  {
    name: 'Raysa Hamilton',
    title: 'Client Success Manager',
    photo: null,
    hasPhoto: false,
    bio: 'Raysa is the primary point of contact for ServiceLinePro clients, managing relationships and ensuring satisfaction across every engagement. She coordinates between clients and the fulfillment team, handles onboarding, schedules strategy reviews, and proactively identifies growth opportunities. Her focus on communication and transparency reflects the agency\'s commitment to treating every client like a partner.',
    linkedin: null,
  },
  {
    name: 'Daniel Gomez',
    title: 'Director of Fulfillment',
    photo: null,
    hasPhoto: false,
    bio: 'Daniel leads the fulfillment team responsible for executing every SEO, PPC, and web design deliverable. From technical audits and citation building to campaign launches and landing page optimization, Daniel ensures the work gets done on time and at the highest standard. His systematic approach to project management and quality control is the backbone of ServiceLinePro\'s consistent client results.',
    linkedin: null,
  },
  {
    name: 'Kevin Morales',
    title: 'SEO Strategist',
    photo: null,
    hasPhoto: false,
    bio: 'Kevin drives the local SEO strategy for ServiceLinePro clients, managing Google Business Profile optimization, citation networks, geo-targeted ranking signals, and content creation. He monitors geo-grid rankings, analyzes competitor movements, and implements the Foundation + Accelerator system that powers the 90-Day Top 3 Guarantee. Kevin\'s data-driven approach ensures every campaign is built on measurable, repeatable results.',
    linkedin: null,
  },
  {
    name: 'Cade Hanson',
    title: 'PPC Campaign Manager',
    photo: null,
    hasPhoto: false,
    bio: 'Cade manages paid search campaigns across Google, Bing, and Yahoo through the Spectrum Reach platform. He handles keyword research, ad copywriting, bid optimization, landing page strategy, and conversion tracking. His focus on speed-to-lead optimization and heat map analysis ensures every click has the highest possible chance of becoming a booked job for our clients.',
    linkedin: null,
  },
  {
    name: 'Jonah Galobardi',
    title: 'Web Developer & Designer',
    photo: null,
    hasPhoto: false,
    bio: 'Jonah designs and develops the high-performance websites that power ServiceLinePro client campaigns. Specializing in Astro and modern web technologies, he builds conversion-optimized, mobile-first sites that load in under two seconds and are engineered to rank. From custom designs to CMS integration, Jonah ensures every website is a lead-generating machine.',
    linkedin: null,
  },
];
---

<PageLayout
  title="About ServiceLinePro | Meet Our Team"
  description="Meet the ServiceLinePro team — a Tampa-based digital marketing agency built exclusively for home services businesses doing $1M+ annually. CEO Will Hamilton and 7 specialists driving results across SEO, PPC, web design, and TV advertising."
  canonicalUrl="https://servicelinepro.com/about/"
>

  <!-- JSON-LD Schema -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "mainEntity": {
        "@type": "Organization",
        "name": "ServiceLinePro",
        "url": "https://servicelinepro.com",
        "foundingDate": "2020",
        "foundingLocation": { "@type": "Place", "name": "Tampa, FL" },
        "description": "Digital marketing agency built exclusively for home services businesses doing $1M+ annually.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "8770 Huntfield St",
          "addressLocality": "Tampa",
          "addressRegion": "FL",
          "postalCode": "33635",
          "addressCountry": "US"
        },
        "telephone": "(813) 521-3199",
        "email": "contact@servicelinepro.com",
        "numberOfEmployees": { "@type": "QuantitativeValue", "value": 7 },
        "member": teamMembers.map((m, i) => ({
          "@type": "Person",
          "name": m.name,
          "jobTitle": m.title,
          ...(m.linkedin ? { "sameAs": m.linkedin } : {})
        }))
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://servicelinepro.com/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://servicelinepro.com/about/" }
      ]
    })} />
  </Fragment>

  <!-- Breadcrumb -->
  <nav class="bg-brand-dark/95 border-b border-white/10 py-3">
    <div class="container mx-auto px-4">
      <ol class="flex items-center gap-2 text-sm text-gray-400">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li class="text-gray-600">/</li>
        <li class="text-brand-red font-medium">About Us</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="section-dark py-20 md:py-28">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block bg-brand-red/15 text-brand-red text-sm font-semibold tracking-wider uppercase px-4 py-2 rounded-full mb-6">Tampa HQ • National Reach</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white mb-6 leading-tight">
          Built by Operators,<br />
          <span class="text-brand-red">for Operators</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-3xl mx-auto leading-relaxed">
          ServiceLinePro is a performance-first digital marketing agency built exclusively for home services businesses doing $1M+ in annual revenue. We exist because the industry deserves better than black-box reporting and empty promises.
        </p>
        <div class="flex flex-wrap justify-center gap-6 text-sm text-gray-400">
          <span class="flex items-center gap-2">🏠 Founded 2020</span>
          <span class="flex items-center gap-2">📍 Tampa, Florida</span>
          <span class="flex items-center gap-2">🇺🇸 Serving All 50 States</span>
          <span class="flex items-center gap-2">⭐ 4.9/5 Client Rating</span>
        </div>
      </div>
    </div>
  </section>

  <TrustSignals />

  <!-- Our Story -->
  <section class="section-light py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-dark text-center mb-12">
          The Story Behind ServiceLinePro
        </h2>
        <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
          <p>
            In 2020, Will Hamilton identified a problem that was costing home services businesses millions: they were pouring money into marketing agencies that delivered dashboards full of vanity metrics — impressions, clicks, reach — but could never connect those numbers to actual jobs booked and revenue earned.
          </p>
          <p>
            Will had started his career at 16 in high-stakes production work — film, editing, weddings, music — where results are immediate and quality is non-negotiable. After moving to Florida and entering the digital marketing space, he saw the gap clearly. Home service companies doing $1M, $3M, $5M+ in annual revenue were trusting agencies that could not answer the most basic question: <strong>"How many jobs did your marketing generate this month?"</strong>
          </p>
          <p>
            ServiceLinePro was built to answer that question every single month. The model is performance-first: every strategy, every campaign, every dollar is tied directly to leads, booked jobs, and revenue. No fluff, no filler, no six-month ramp-up with nothing to show for it.
          </p>
          <p>
            Today, the team has grown to seven specialists across SEO, PPC, web design, and TV/streaming advertising. The Spectrum Reach partnership — a game-changing alliance with Charter Communications' advertising division — gives ServiceLinePro clients access to 30+ million households of first-party data, enterprise-level ad buying power, and free professional videography for Florida clients.
          </p>
          <p>
            Headquartered in Tampa with clients across the country, ServiceLinePro serves HVAC, plumbing, roofing, electrical, painting, construction, and general contracting companies that are serious about growth. If your business does $1M+ and you want marketing that actually moves the needle, you are in the right place.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section-dark py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-white text-center mb-12">
          What We Stand For
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10 text-center">
            <div class="text-4xl mb-4">📊</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">Performance First</h3>
            <p class="text-gray-400 text-sm">Every strategy ties back to leads, jobs, and revenue. If we cannot measure it, we do not recommend it.</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10 text-center">
            <div class="text-4xl mb-4">🔍</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">Full Transparency</h3>
            <p class="text-gray-400 text-sm">You own your accounts, see your data, and know exactly where every dollar goes. No black boxes.</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10 text-center">
            <div class="text-4xl mb-4">🤝</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">No Contracts</h3>
            <p class="text-gray-400 text-sm">We earn your business every month. No lock-in agreements. If we are not delivering, you can walk.</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10 text-center">
            <div class="text-4xl mb-4">🇺🇸</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">American Built</h3>
            <p class="text-gray-400 text-sm">Every team member is U.S.-based. We work American hours, speak your language, and share your values.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="section-light py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-dark mb-4">
            Meet the Team
          </h2>
          <p class="text-gray-600 text-lg max-w-2xl mx-auto">
            Seven specialists dedicated to one mission: making home services businesses dominate their markets through performance-driven digital marketing.
          </p>
        </div>

        <!-- Leadership Row -->
        <div class="grid md:grid-cols-2 gap-8 mb-8 max-w-3xl mx-auto">
          {teamMembers.slice(0, 2).map((member) => (
            <div class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-lg hover:shadow-xl transition-shadow">
              <div class="aspect-[4/3] bg-brand-dark/5 flex items-center justify-center overflow-hidden">
                {member.hasPhoto ? (
                  <img
                    src={member.photo}
                    alt={`${member.name} — ${member.title} at ServiceLinePro`}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-brand-dark to-brand-dark/80 flex items-center justify-center">
                    <span class="text-6xl font-heading font-bold text-white/20">{member.name.split(' ').map(n => n[0]).join('')}</span>
                  </div>
                )}
              </div>
              <div class="p-6">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-xl font-heading font-bold text-brand-dark">{member.name}</h3>
                  {member.linkedin && (
                    <a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 transition-colors" aria-label={`${member.name} LinkedIn`}>
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>
                  )}
                </div>
                <p class="text-brand-red font-semibold text-sm mb-3">{member.title}</p>
                <p class="text-gray-600 text-sm leading-relaxed">{member.bio}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Team Grid -->
        <div class="grid md:grid-cols-3 lg:grid-cols-5 gap-6">
          {teamMembers.slice(2).map((member) => (
            <div class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-md hover:shadow-lg transition-shadow">
              <div class="aspect-square bg-brand-dark/5 flex items-center justify-center overflow-hidden">
                {member.hasPhoto ? (
                  <img
                    src={member.photo}
                    alt={`${member.name} — ${member.title} at ServiceLinePro`}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-brand-dark to-brand-dark/80 flex items-center justify-center">
                    <span class="text-4xl font-heading font-bold text-white/20">{member.name.split(' ').map(n => n[0]).join('')}</span>
                  </div>
                )}
              </div>
              <div class="p-4">
                <h3 class="text-base font-heading font-bold text-brand-dark">{member.name}</h3>
                <p class="text-brand-red font-semibold text-xs mb-2">{member.title}</p>
                <p class="text-gray-600 text-xs leading-relaxed line-clamp-4">{member.bio.substring(0, 150)}...</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section-dark py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-white text-center mb-12">
          Our Journey
        </h2>
        <div class="space-y-8">
          <div class="flex gap-6">
            <div class="flex-shrink-0 w-20 text-right">
              <span class="text-brand-red font-heading font-bold text-lg">2020</span>
            </div>
            <div class="flex-shrink-0 w-px bg-white/20 relative">
              <div class="absolute top-1 left-1/2 -translate-x-1/2 w-3 h-3 bg-brand-red rounded-full"></div>
            </div>
            <div class="pb-8">
              <h3 class="text-white font-heading font-bold mb-1">ServiceLinePro Founded</h3>
              <p class="text-gray-400 text-sm">Will Hamilton launches ServiceLinePro in Tampa, FL with a mission to bring accountability and performance tracking to home services marketing.</p>
            </div>
          </div>
          <div class="flex gap-6">
            <div class="flex-shrink-0 w-20 text-right">
              <span class="text-brand-red font-heading font-bold text-lg">2021</span>
            </div>
            <div class="flex-shrink-0 w-px bg-white/20 relative">
              <div class="absolute top-1 left-1/2 -translate-x-1/2 w-3 h-3 bg-brand-red rounded-full"></div>
            </div>
            <div class="pb-8">
              <h3 class="text-white font-heading font-bold mb-1">First Major Client Wins</h3>
              <p class="text-gray-400 text-sm">Secured HVAC and plumbing clients generating $1M+ annually. Proved the performance-first model with measurable ROI from day one.</p>
            </div>
          </div>
          <div class="flex gap-6">
            <div class="flex-shrink-0 w-20 text-right">
              <span class="text-brand-red font-heading font-bold text-lg">2023</span>
            </div>
            <div class="flex-shrink-0 w-px bg-white/20 relative">
              <div class="absolute top-1 left-1/2 -translate-x-1/2 w-3 h-3 bg-brand-red rounded-full"></div>
            </div>
            <div class="pb-8">
              <h3 class="text-white font-heading font-bold mb-1">Spectrum Reach Partnership</h3>
              <p class="text-gray-400 text-sm">Partnered with Spectrum Reach (Charter Communications) for enterprise-level PPC and TV/streaming advertising. Access to 30M+ household data across 36 states.</p>
            </div>
          </div>
          <div class="flex gap-6">
            <div class="flex-shrink-0 w-20 text-right">
              <span class="text-brand-red font-heading font-bold text-lg">2024</span>
            </div>
            <div class="flex-shrink-0 w-px bg-white/20 relative">
              <div class="absolute top-1 left-1/2 -translate-x-1/2 w-3 h-3 bg-brand-red rounded-full"></div>
            </div>
            <div class="pb-8">
              <h3 class="text-white font-heading font-bold mb-1">National Expansion</h3>
              <p class="text-gray-400 text-sm">Expanded from Tampa-area clients to serving home services businesses across the United States. Team grew to 7 dedicated specialists.</p>
            </div>
          </div>
          <div class="flex gap-6">
            <div class="flex-shrink-0 w-20 text-right">
              <span class="text-brand-gold font-heading font-bold text-lg">2026</span>
            </div>
            <div class="flex-shrink-0 w-px bg-white/20 relative">
              <div class="absolute top-1 left-1/2 -translate-x-1/2 w-3 h-3 bg-brand-gold rounded-full"></div>
            </div>
            <div>
              <h3 class="text-white font-heading font-bold mb-1">500+ Keywords Ranked, 8+ Industries</h3>
              <p class="text-gray-400 text-sm">Serving clients across HVAC, plumbing, roofing, electrical, painting, construction, aluminum, and general contracting. 90-Day Top 3 Guarantee powering growth nationwide.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    headline="Ready to Work With a Team That Gets Results?"
    subheadline="Book a free strategy call and see how ServiceLinePro can help your home services business dominate its market."
    buttonText="Book Your Free Strategy Call →"
    buttonHref="/booking/"
    secondaryText="Call (813) 521-3199"
    secondaryHref="tel:8135213199"
  />

</PageLayout>
