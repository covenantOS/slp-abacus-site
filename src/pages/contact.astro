---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Contact" description="Get in touch with ServiceLinePro. Book a strategy call or reach out directly.">
  <section class="section-dark py-20">
    <div class="container">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Contact Us</h1>
      <p class="text-brand-medium-gray text-lg max-w-2xl">
        Ready to grow your home services business? Get in touch for a free strategy call.
      </p>
    </div>
  </section>
  <section class="py-16">
    <div class="container">
      <p class="text-lg text-brand-near-black leading-relaxed">
        Contact form and details coming soon.
      </p>
    </div>
  </section>
</PageLayout>
