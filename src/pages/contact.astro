---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/CTASection.astro';
---

<PageLayout
  title="Contact ServiceLinePro | Book a Free Strategy Call"
  description="Contact ServiceLinePro — Tampa-based digital marketing agency for home services businesses. Call (813) 521-3199, email contact@servicelinepro.com, or book a free strategy call. Mon–Fri 7am–7pm EST."
  canonicalUrl="https://servicelinepro.com/contact/"
>

  <!-- JSON-LD Schema -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "mainEntity": {
        "@type": "LocalBusiness",
        "name": "ServiceLinePro",
        "url": "https://servicelinepro.com",
        "telephone": "(813) 521-3199",
        "email": "contact@servicelinepro.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "8770 Huntfield St",
          "addressLocality": "Tampa",
          "addressRegion": "FL",
          "postalCode": "33635",
          "addressCountry": "US"
        },
        "openingHoursSpecification": [
          { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "07:00", "closes": "19:00" },
          { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "11:00", "closes": "17:00" }
        ],
        "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "bestRating": "5", "ratingCount": "50" }
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://servicelinepro.com/" },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://servicelinepro.com/contact/" }
      ]
    })} />
  </Fragment>

  <!-- Breadcrumb -->
  <nav class="bg-brand-dark/95 border-b border-white/10 py-3">
    <div class="container mx-auto px-4">
      <ol class="flex items-center gap-2 text-sm text-gray-400">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li class="text-gray-600">/</li>
        <li class="text-brand-red font-medium">Contact</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="section-dark py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white mb-6 leading-tight">
          Let's Build Your<br />
          <span class="text-brand-red">Growth Plan</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-2xl mx-auto leading-relaxed">
          Ready to dominate your local market? Book a free strategy call, give us a ring, or fill out the form below. No pressure, no contracts — just a clear path to more leads and revenue.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Grid -->
  <section class="section-light py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-5 gap-12">

          <!-- Contact Info Column -->
          <div class="lg:col-span-2">
            <h2 class="text-2xl font-heading font-bold text-brand-dark mb-6">Get in Touch</h2>

            <!-- Phone -->
            <div class="mb-8">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 bg-brand-red/10 rounded-lg flex items-center justify-center text-brand-red">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                </div>
                <div>
                  <p class="text-sm text-gray-500 font-medium">Phone</p>
                  <a href="tel:8135213199" class="text-brand-dark font-heading font-bold text-lg hover:text-brand-red transition-colors">(813) 521-3199</a>
                </div>
              </div>
            </div>

            <!-- Email -->
            <div class="mb-8">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 bg-brand-red/10 rounded-lg flex items-center justify-center text-brand-red">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
                <div>
                  <p class="text-sm text-gray-500 font-medium">Email</p>
                  <a href="mailto:contact@servicelinepro.com" class="text-brand-dark font-heading font-bold text-lg hover:text-brand-red transition-colors">contact@servicelinepro.com</a>
                </div>
              </div>
            </div>

            <!-- Address -->
            <div class="mb-8">
              <div class="flex items-start gap-3 mb-2">
                <div class="w-10 h-10 bg-brand-red/10 rounded-lg flex items-center justify-center text-brand-red flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                </div>
                <div>
                  <p class="text-sm text-gray-500 font-medium">Office</p>
                  <p class="text-brand-dark font-heading font-bold">8770 Huntfield St</p>
                  <p class="text-gray-600">Tampa, FL 33635</p>
                </div>
              </div>
            </div>

            <!-- Hours -->
            <div class="mb-8">
              <div class="flex items-start gap-3 mb-2">
                <div class="w-10 h-10 bg-brand-red/10 rounded-lg flex items-center justify-center text-brand-red flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                  <p class="text-sm text-gray-500 font-medium">Business Hours (EST)</p>
                  <p class="text-brand-dark font-semibold">Mon – Fri: 7:00 AM – 7:00 PM</p>
                  <p class="text-brand-dark font-semibold">Saturday: 11:00 AM – 5:00 PM</p>
                  <p class="text-gray-500">Sunday: Closed</p>
                </div>
              </div>
            </div>

            <!-- Social Links -->
            <div class="mb-8">
              <p class="text-sm text-gray-500 font-medium mb-3">Follow Us</p>
              <div class="flex gap-3">
                <a href="https://www.facebook.com/ServiceLineAI" target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-brand-dark/10 rounded-lg flex items-center justify-center text-brand-dark hover:bg-brand-red hover:text-white transition-all" aria-label="Facebook">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
                <a href="https://www.instagram.com/servicelinepro/" target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-brand-dark/10 rounded-lg flex items-center justify-center text-brand-dark hover:bg-brand-red hover:text-white transition-all" aria-label="Instagram">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                </a>
                <a href="https://upload.wikimedia.org/wikipedia/commons/thumb/8/81/LinkedIn_icon.svg/3840px-LinkedIn_icon.svg.png" target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-brand-dark/10 rounded-lg flex items-center justify-center text-brand-dark hover:bg-brand-red hover:text-white transition-all" aria-label="LinkedIn">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
              </div>
            </div>

            <!-- Google Business Profile -->
            <a
              href="https://www.google.com/maps/place/ServiceLine+Pro/data=!4m2!3m1!1s0x0:0x69a267500e8cd7f6?sa=X&ved=1t:2428&ictx=111"
              target="_blank"
              rel="noopener noreferrer"
              class="block bg-white rounded-xl p-4 border border-gray-200 hover:border-brand-red hover:shadow-md transition-all"
            >
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-brand-gold/10 rounded-lg flex items-center justify-center flex-shrink-0">
                  <span class="text-xl">⭐</span>
                </div>
                <div>
                  <p class="text-brand-dark font-heading font-bold text-sm">4.9/5 on Google</p>
                  <p class="text-gray-500 text-xs">View our Google Business Profile →</p>
                </div>
              </div>
            </a>

            <!-- Map Embed -->
            <div class="mt-6 rounded-xl overflow-hidden border border-gray-200 shadow-sm">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3524.5!2d-82.6!3d28.05!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x69a267500e8cd7f6!2sServiceLine%20Pro!5e0!3m2!1sen!2sus!4v1"
                width="100%"
                height="220"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="ServiceLinePro office location on Google Maps"
              ></iframe>
            </div>
          </div>

          <!-- Contact Form Column -->
          <div class="lg:col-span-3">
            <div class="bg-white rounded-2xl p-8 md:p-10 border border-gray-200 shadow-lg">
              <h2 class="text-2xl font-heading font-bold text-brand-dark mb-2">Book Your Free Strategy Call</h2>
              <p class="text-gray-600 mb-8">Tell us about your business and goals. We will respond within one business day with a custom growth plan — no strings attached.</p>

              <form id="contact-form" class="space-y-6" action="#" method="POST">
                <!-- Name Row -->
                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <label for="first-name" class="block text-sm font-semibold text-brand-dark mb-1.5">First Name <span class="text-brand-red">*</span></label>
                    <input
                      type="text"
                      id="first-name"
                      name="first_name"
                      required
                      placeholder="John"
                      class="w-full px-4 py-3 border border-gray-300 rounded-xl text-brand-dark placeholder-gray-400 focus:ring-2 focus:ring-brand-red/30 focus:border-brand-red transition-colors"
                    />
                  </div>
                  <div>
                    <label for="last-name" class="block text-sm font-semibold text-brand-dark mb-1.5">Last Name <span class="text-brand-red">*</span></label>
                    <input
                      type="text"
                      id="last-name"
                      name="last_name"
                      required
                      placeholder="Smith"
                      class="w-full px-4 py-3 border border-gray-300 rounded-xl text-brand-dark placeholder-gray-400 focus:ring-2 focus:ring-brand-red/30 focus:border-brand-red transition-colors"
                    />
                  </div>
                </div>

                <!-- Contact Row -->
                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <label for="email" class="block text-sm font-semibold text-brand-dark mb-1.5">Email <span class="text-brand-red">*</span></label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      placeholder="john@example.com"
                      class="w-full px-4 py-3 border border-gray-300 rounded-xl text-brand-dark placeholder-gray-400 focus:ring-2 focus:ring-brand-red/30 focus:border-brand-red transition-colors"
                    />
                  </div>
                  <div>
                    <label for="phone" class="block text-sm font-semibold text-brand-dark mb-1.5">Phone <span class="text-brand-red">*</span></label>
                    <input
                      type="tel"
                      id="phone"
                      name="phone"
                      required
                      placeholder="(555) 123-4567"
                      class="w-full px-4 py-3 border border-gray-300 rounded-xl text-brand-dark placeholder-gray-400 focus:ring-2 focus:ring-brand-red/30 focus:border-brand-red transition-colors"
                    />
                  </div>
                </div>

                <!-- Business Info -->
                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <label for="company" class="block text-sm font-semibold text-brand-dark mb-1.5">Company Name <span class="text-brand-red">*</span></label>
                    <input
                      type="text"
                      id="company"
                      name="company"
                      required
                      placeholder="ABC Plumbing"
                      class="w-full px-4 py-3 border border-gray-300 rounded-xl text-brand-dark placeholder-gray-400 focus:ring-2 focus:ring-brand-red/30 focus:border-brand-red transition-colors"
                    />
                  </div>
                  <div>
                    <label for="industry" class="block text-sm font-semibold text-brand-dark mb-1.5">Industry <span class="text-brand-red">*</span></label>
                    <select
                      id="industry"
                      name="industry"
                      required
                      class="w-full px-4 py-3 border border-gray-300 rounded-xl text-brand-dark focus:ring-2 focus:ring-brand-red/30 focus:border-brand-red transition-colors bg-white"
                    >
                      <option value="">Select your industry</option>
                      <option value="hvac">HVAC</option>
                      <option value="plumbing">Plumbing</option>
                      <option value="roofing">Roofing</option>
                      <option value="electrical">Electrical</option>
                      <option value="painting">Painting</option>
                      <option value="construction">Construction</option>
                      <option value="aluminum">Aluminum / Screen</option>
                      <option value="contractors">General Contracting</option>
                      <option value="other">Other Home Services</option>
                    </select>
                  </div>
                </div>

                <!-- Revenue & Service -->
                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <label for="revenue" class="block text-sm font-semibold text-brand-dark mb-1.5">Annual Revenue</label>
                    <select
                      id="revenue"
                      name="revenue"
                      class="w-full px-4 py-3 border border-gray-300 rounded-xl text-brand-dark focus:ring-2 focus:ring-brand-red/30 focus:border-brand-red transition-colors bg-white"
                    >
                      <option value="">Select range</option>
                      <option value="under-1m">Under $1M</option>
                      <option value="1m-3m">$1M – $3M</option>
                      <option value="3m-5m">$3M – $5M</option>
                      <option value="5m-10m">$5M – $10M</option>
                      <option value="10m-plus">$10M+</option>
                    </select>
                  </div>
                  <div>
                    <label for="service-interest" class="block text-sm font-semibold text-brand-dark mb-1.5">Service Interest</label>
                    <select
                      id="service-interest"
                      name="service_interest"
                      class="w-full px-4 py-3 border border-gray-300 rounded-xl text-brand-dark focus:ring-2 focus:ring-brand-red/30 focus:border-brand-red transition-colors bg-white"
                    >
                      <option value="">What are you looking for?</option>
                      <option value="local-seo">Local SEO / Map Pack</option>
                      <option value="ppc">PPC / Google Ads</option>
                      <option value="web-design">Website Design</option>
                      <option value="tv-streaming">TV / Streaming Ads</option>
                      <option value="full-service">Full Marketing Package</option>
                      <option value="not-sure">Not Sure — Need Guidance</option>
                    </select>
                  </div>
                </div>

                <!-- Message -->
                <div>
                  <label for="message" class="block text-sm font-semibold text-brand-dark mb-1.5">Tell Us About Your Goals</label>
                  <textarea
                    id="message"
                    name="message"
                    rows="4"
                    placeholder="What are your biggest marketing challenges? What does success look like for your business?"
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl text-brand-dark placeholder-gray-400 focus:ring-2 focus:ring-brand-red/30 focus:border-brand-red transition-colors resize-none"
                  ></textarea>
                </div>

                <!-- Submit -->
                <button
                  type="submit"
                  class="w-full btn-primary py-4 text-lg font-bold rounded-xl"
                >
                  Get My Free Strategy Plan →
                </button>

                <!-- Trust Copy -->
                <div class="flex items-center justify-center gap-4 text-xs text-gray-400 pt-2">
                  <span class="flex items-center gap-1">🔒 Your info is secure</span>
                  <span>•</span>
                  <span>No spam, ever</span>
                  <span>•</span>
                  <span>Response within 1 business day</span>
                </div>
              </form>
            </div>

            <!-- Quick Contact Alternatives -->
            <div class="grid md:grid-cols-2 gap-4 mt-6">
              <a href="/booking/" class="block bg-brand-dark rounded-xl p-6 text-center hover:bg-brand-dark/90 transition-colors">
                <div class="text-3xl mb-2">📅</div>
                <h3 class="text-white font-heading font-bold mb-1">Book a Call Directly</h3>
                <p class="text-gray-400 text-sm">Choose a time that works for you on our scheduling page.</p>
              </a>
              <a href="tel:8135213199" class="block bg-brand-red rounded-xl p-6 text-center hover:bg-brand-red/90 transition-colors">
                <div class="text-3xl mb-2">📞</div>
                <h3 class="text-white font-heading font-bold mb-1">Call Us Now</h3>
                <p class="text-white/80 text-sm">(813) 521-3199 — Mon–Fri 7am–7pm EST</p>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Reach Out Section -->
  <section class="section-dark py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-4">
          What Happens After You Reach Out
        </h2>
        <p class="text-gray-400 text-lg mb-12 max-w-2xl mx-auto">
          No pressure. No hard sell. Just a clear conversation about your business and how we can help.
        </p>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white/5 rounded-2xl p-8 border border-white/10">
            <div class="w-12 h-12 bg-brand-red rounded-xl flex items-center justify-center text-white font-bold text-lg mx-auto mb-4">1</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">We Review Your Business</h3>
            <p class="text-gray-400 text-sm">Before the call, we research your market, competitors, and current online presence so we come prepared with real insights — not a generic pitch.</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-8 border border-white/10">
            <div class="w-12 h-12 bg-brand-red rounded-xl flex items-center justify-center text-white font-bold text-lg mx-auto mb-4">2</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">Strategy Call (30 min)</h3>
            <p class="text-gray-400 text-sm">We discuss your goals, pain points, and budget. You get honest recommendations — including whether we are the right fit. If we are not, we will tell you.</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-8 border border-white/10">
            <div class="w-12 h-12 bg-brand-red rounded-xl flex items-center justify-center text-white font-bold text-lg mx-auto mb-4">3</div>
            <h3 class="text-lg font-heading font-bold text-white mb-2">Custom Growth Plan</h3>
            <p class="text-gray-400 text-sm">Within 48 hours, you receive a personalized marketing plan with specific recommendations, pricing, and projected ROI for your business.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    headline="Your Competitors Aren't Waiting"
    subheadline="Every day without a growth plan is a day your competitors are pulling ahead. Let's change that — book your free strategy call today."
    buttonText="Book Your Free Strategy Call →"
    buttonHref="/booking/"
    secondaryText="Call (813) 521-3199"
    secondaryHref="tel:8135213199"
  />

</PageLayout>

<script>
  // Form submission handler
  const form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      if (btn) {
        btn.textContent = 'Sending...';
        btn.setAttribute('disabled', 'true');
        // Simulate submission - replace with actual endpoint
        setTimeout(() => {
          form.innerHTML = `
            <div class="text-center py-8">
              <div class="text-5xl mb-4">✅</div>
              <h3 class="text-2xl font-heading font-bold text-brand-dark mb-3">Message Received!</h3>
